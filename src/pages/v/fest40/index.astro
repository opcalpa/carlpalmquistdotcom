---
// "Kalaset" — publik eventplanerings-sida. Design: design_handoff_fest40 (Claude Design 2026-08-26).
// Datadriven: ALLT innehåll kommer ur KV via /api/fest40?slug=. Ingen eventdata i denna publika källa.
const slug = "calle40";
---
<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Kalaset</title>
<meta name="robots" content="noindex, nofollow" />
<style is:global>
:root{
  --bg:#faf7f2; --panel:#fffdfa; --panel2:#f4efe6; --line:#e7dfd2; --line-soft:#f2ebdd; --line-strong:#d8cdbb;
  --txt:#2b2723; --mid:#5c5548; --dim:#8b8272; --faint:#b3aa99;
  --accent:#6c8cff; --accent-ink:#4d68d8;
  --champ:#c8ab77; --champ-ink:#8a6f3f; --champ-line:#ead9bd;
  --ok-ink:#2f9e6e; --warn-ink:#a1782a; --late-ink:#cf5570;
  --r-card:14px; --r-field:8px; --r-track:10px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--txt);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,sans-serif;-webkit-font-smoothing:antialiased}
.num{font-variant-numeric:tabular-nums}
/* Korten är flex-barn i en kolumn. Utan min-width:0 kan ett barn med brett innehåll spränga
   .wrap, och då blir sektionerna olika breda — hjärtat ovanför lika brett som listorna under
   är hela poängen med att de ligger i samma spalt. */
.wrap{max-width:1180px;margin:0 auto;padding:16px 16px 22px;display:flex;flex-direction:column;gap:12px}
.wrap>*{min-width:0}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-card)}
.lbl{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;color:var(--dim)}
button{font:inherit;cursor:pointer}
.btn{height:44px;padding:0 16px;border-radius:var(--r-field);border:1px solid var(--line);background:var(--panel);color:var(--txt);font-size:14px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
.btn.wide{width:100%}

/* ---- grind ---- */
#gate{min-height:100dvh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;padding:22px}
.invite{max-width:330px;width:100%;padding:8px}
.invite-in{border:1px solid var(--champ-line);border-radius:var(--r-track);padding:28px 22px;text-align:center}
.mono{width:56px;height:56px;border-radius:999px;border:1px solid var(--champ-line);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:18px;font-weight:650;color:var(--champ-ink)}
.rule{width:44px;height:1px;background:var(--champ);margin:16px auto}
#code{width:100%;height:52px;margin-top:16px;text-align:center;font-size:18px;letter-spacing:6px;border:1px solid var(--line);border-radius:var(--r-field);background:var(--panel);color:var(--txt)}
#code:focus{outline:none;border-color:var(--accent)}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.shake{animation:shake .3s ease}

/* ---- hjärtat ---- */
.heart{padding:8px}
.heart-in{border:1px solid var(--champ-line);border-radius:var(--r-track);padding:22px 16px;text-align:center}
.heart h1{margin:8px 0 0;font-size:26px;font-weight:650;letter-spacing:-.2px}
.pill{display:inline-block;padding:5px 14px;border-radius:999px;font-size:12px;font-weight:600;background:rgba(200,171,119,.14);border:1px solid rgba(200,171,119,.4);color:var(--champ-ink)}
.track{height:5px;border-radius:999px;background:#f0e8d9;margin:16px auto 8px;max-width:280px;overflow:hidden}
.fill{height:100%;background:rgba(55,193,132,.8);border-radius:999px;transition:width .12s ease}

/* ---- sektioner ---- */
.sec{padding:16px;min-width:0}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
.sec-head h2{margin:0;font-size:18px;font-weight:650}
.seg{display:flex;background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-track);padding:3px;gap:3px;margin-bottom:12px}
.seg button{flex:1;height:38px;border:1px solid transparent;background:transparent;border-radius:var(--r-field);color:var(--dim);font-size:13px}
.seg button.on{background:var(--panel);border-color:var(--line);color:var(--txt);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.04)}
/* min-width:0 + max-width:100%: raden SCROLLAR vågrätt, alltså ska den aldrig få rösta om
   hur bred kolumnen behöver vara. Utan det växte kortet i stället för att chipsen scrollade. */
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:8px;-webkit-overflow-scrolling:touch;
  min-width:0;max-width:100%}
.chips::-webkit-scrollbar{display:none}
/* Samma grepp som i feeden: en toning i kanten BARA när det finns fler chips åt höger, så
   den hårda kapningen läses som "det finns mer" i stället för som ett fel. Klassen sätts i
   wire() efter varje omritning — bredden beror på hur många taggar listan har just nu. */
.chips.mer{mask-image:linear-gradient(to right,#000 calc(100% - 28px),transparent);
  -webkit-mask-image:linear-gradient(to right,#000 calc(100% - 28px),transparent)}
.chip{white-space:nowrap;padding:5px 12px;border-radius:999px;font-size:12px;border:1px solid var(--line);background:var(--panel2);color:var(--mid)}
.chip.on{background:rgba(108,140,255,.12);border-color:rgba(108,140,255,.45);color:var(--accent-ink);font-weight:600}
/* En färdig tagg tonas ned men behåller sin färg — man ska känna igen den, inte leta efter
   den. Bocken ersätter siffran: "0" ser ut som ett fel, "✓" säger vad det betyder. */
.chip.klar{opacity:.55;font-weight:500}
.chip.klar:hover{opacity:1}
/* Gruppchipen bär ingen taggfärg — den är ett fack, inte en tagg. */
.chip.klargrupp{background:rgba(55,193,132,.1);border-color:rgba(55,193,132,.32);color:var(--ok-ink);font-weight:600}
.chip.klargrupp.on{background:rgba(55,193,132,.18);border-color:rgba(55,193,132,.5)}
/* Andra raden ligger indragen så det syns att den hör till gruppen ovanför. */
.chips.klarrad{margin-top:-4px;padding-left:14px;border-left:2px solid rgba(55,193,132,.25)}
.row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--line-soft)}
.row:last-child{border-bottom:0}
.box{flex:0 0 auto;width:26px;height:26px;border-radius:999px;border:1.5px solid var(--line-strong);background:var(--panel);display:flex;align-items:center;justify-content:center;font-size:13px;color:transparent;transition:.12s ease}
.row.done .box{background:rgba(55,193,132,.15);border-color:rgba(55,193,132,.5);color:var(--ok-ink)}
.row-txt{flex:1;min-width:0}
.row-txt .t{font-size:15px;transition:.12s ease}
.row.done .t{color:var(--dim);text-decoration:line-through;text-decoration-color:rgba(139,130,114,.45)}
.tag{display:inline-block;margin-top:4px;padding:3px 10px;border-radius:999px;font-size:11px;background:var(--panel2);border:1px solid var(--line);color:var(--mid)}
.row.done .tag{background:#f8f4ec;border-color:#efe8da;color:var(--faint)}
.due{flex:0 0 auto;font-size:12px;font-weight:600;color:var(--dim)}
.due.today{color:var(--warn-ink)}.due.late{color:var(--late-ink)}
.divider{margin:12px 0 4px}
.add{display:flex;gap:8px;margin-top:12px}
.add input{flex:1;min-width:0;height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-field);background:var(--panel);color:var(--txt);font-size:14px}
.add input:focus{outline:none;border-color:var(--accent)}
.act{margin-top:12px;font-size:12px;color:var(--dim)}
.callout{padding:12px;border-radius:var(--r-field);background:rgba(55,193,132,.1);border:1px solid rgba(55,193,132,.3);color:var(--ok-ink);font-size:13px;font-weight:600}

/* program */
.tl{display:flex;gap:12px;align-items:flex-start}
.tl .time{flex:0 0 42px;text-align:right;font-size:13px;color:var(--dim)}
.tl .dotcol{flex:0 0 9px;display:flex;flex-direction:column;align-items:center;align-self:stretch;padding-top:6px}
.tl .dot{width:9px;height:9px;border-radius:999px;background:var(--champ);flex:0 0 auto}
.tl .line{width:1px;flex:1;background:var(--champ-line);margin-top:4px}
.tl .txt{flex:1;font-size:14px;padding-bottom:16px}

/* gäster */
.stats{display:flex;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.stat{flex:1;padding:12px 0;text-align:center;border-right:1px solid var(--line-soft)}
.stat:last-child{border-right:0}
.stat b{display:block;font-size:22px;font-weight:650}
.g-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line-soft)}
.spill{padding:5px 14px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid;background:var(--panel2);border-color:var(--line);color:var(--mid)}
.spill.ja{background:rgba(55,193,132,.15);border-color:rgba(55,193,132,.35);color:var(--ok-ink)}
.spill.vantar{background:rgba(230,180,80,.16);border-color:rgba(230,180,80,.4);color:var(--warn-ink)}
/* "Ej bjuden" är INTE ett nej. Utan eget läge ritades tretton objudna släktingar som avböjda,
   och ett tryck skickade dem rakt till "Ja" utan väg tillbaka. */
.spill.ejbj{background:transparent;border-style:dashed;border-color:var(--line-strong);color:var(--faint)}

details.foldable{padding:0}
details.foldable summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;padding:0 16px;cursor:pointer}
details.foldable summary::-webkit-details-marker{display:none}
/* Ändra/ta bort direkt på raden. Syns alltid — mobilen har ingen hover, och det här ska
   fungera som ett delat kalkylark där alla vågar redigera. */
.row-btn{width:30px;height:30px;flex:0 0 auto;border:1px solid transparent;border-radius:var(--r-field);
  background:transparent;color:var(--faint);font-size:13px;padding:0;display:flex;align-items:center;justify-content:center}
.row-btn:hover{border-color:var(--line);color:var(--txt)}
.row.done .row-btn{opacity:.5}
/* Dubbelklick på texten öppnar redigering. touch-action:manipulation stänger av
   dubbeltryck-zoom, annars zoomar mobilen i stället för att ge oss dblclick-eventet. */
.row{touch-action:manipulation}
.t[data-t]{cursor:text}
.t-edit{width:100%;box-sizing:border-box;font:inherit;font-size:inherit;color:var(--txt);
  background:var(--panel);border:1px solid var(--accent);border-radius:var(--r-field);padding:4px 8px}
/* Pennan behålls BARA på pekskärm. På desktop är dubbelklick hela poängen; på mobilen är
   dubbeltryck för opålitligt för att vara den enda vägen in i redigering. */
.touch-only{display:none}
@media (pointer:coarse){.touch-only{display:flex}}

/* 🍳 Menyn. Gästerna kan föreslå rätter och välja ut dem; utvalda är det som lagas.
   Förslagen tonas ned men göms aldrig — brainstormen ska synas. */
.r-row{display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line-soft)}
.r-row:last-child{border-bottom:0}
.r-thumb{width:52px;height:52px;flex:0 0 52px;border-radius:10px;background-size:cover;background-position:center;
  background-color:var(--panel2);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--faint)}
.r-main{flex:1;min-width:0}
.r-title{font-size:14px;font-weight:600;line-height:1.3}
.r-sub{font-size:12px;color:var(--dim);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.r-sub a{color:var(--champ-ink)}
.r-act{display:flex;gap:4px;flex:0 0 auto;position:relative}
/* ⋯-menyn. Tre knappar per rätt blev en vägg på mobilen; valen bor nu bakom en knapp och
   läggs OVANPÅ raden (absolut) så listan inte hoppar när menyn öppnas. */
.r-meny{position:absolute;top:40px;right:0;z-index:50;min-width:236px;display:flex;flex-direction:column;
  background:var(--panel);border:1px solid var(--line);border-radius:var(--r-field);padding:5px;
  box-shadow:0 12px 34px rgba(60,48,32,.22)}
.r-meny button{display:block;width:100%;text-align:left;background:transparent;border:0;border-radius:8px;
  padding:9px 10px;font:inherit;font-size:14px;color:var(--txt);white-space:nowrap}
.r-meny button:active{background:var(--panel2)}
@media (hover:hover){.r-meny button:hover{background:var(--panel2)}}
.r-meny button.fara:active{color:var(--late-ink)}
.r-meny-sep{height:1px;background:var(--line-soft);margin:4px 6px}
/* 🍳 Tillagad rätt: grön ton på raden + märke i titeln, så läget syns utan att öppna menyn. */
.r-row.kokt{background:rgba(55,193,132,.07);border-radius:var(--r-field)}
.r-kokt{display:inline-block;vertical-align:middle;margin-left:6px;font-size:10px;font-weight:700;
  text-transform:uppercase;letter-spacing:.4px;color:var(--ok-ink);
  background:rgba(55,193,132,.14);border:1px solid rgba(55,193,132,.36);border-radius:999px;padding:1px 7px}
.r-btn{width:34px;height:34px;border-radius:var(--r-field);border:1px solid var(--line);background:var(--panel);
  color:var(--dim);font-size:14px;display:flex;align-items:center;justify-content:center;padding:0}
.r-btn.on{background:rgba(200,171,119,.16);border-color:rgba(200,171,119,.45);color:var(--champ-ink)}
.r-grp{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--dim);font-weight:600;padding:14px 0 2px}
.r-grp:first-child{padding-top:0}
.r-form{display:flex;flex-direction:column;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft)}
.r-form input{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:14px;width:100%;box-sizing:border-box}
.r-form input:focus{outline:none;border-color:var(--accent)}
.b-row{display:flex;justify-content:space-between;gap:12px;padding:10px 16px;border-top:1px solid var(--line-soft);font-size:13px}
.foot{text-align:center;font-size:11px;color:var(--faint);padding:8px 0 0}
#toast{position:fixed;left:16px;right:16px;bottom:16px;max-width:520px;margin:0 auto;background:#2b2723;color:#faf7f2;border-radius:999px;padding:12px 18px;display:none;align-items:center;justify-content:space-between;gap:12px;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:20}
#toast button{background:none;border:0;color:#aabdff;font-weight:650;font-size:13px}
/* ── FULL PARITET (2026-08-27): allt Calle kan ändra i pappen går att ändra här.
   ETT klick öppnar redigering på fälten nedan — de har ingen konkurrerande klick-åtgärd.
   (Checklistans rader HAR en: där bockar ett klick av, därför gäller dubbelklick just där.)
   Dubbeltryck är opålitligt på mobil, och en penn-ikon per fält hade dränkt sidan i ikoner. */
.ed{cursor:text;border-bottom:1px dashed transparent;transition:border-color .12s ease}
.ed:hover{border-bottom-color:var(--line-strong)}
textarea.t-edit{min-height:140px;line-height:1.5;resize:vertical;white-space:pre-wrap;font-family:inherit}

/* budget */
.b-row{display:grid;grid-template-columns:1fr auto 30px;grid-template-areas:"lbl est del" "stat stat stat";
  gap:2px 10px;align-items:center}
.b-lbl{grid-area:lbl;min-width:0}
.b-est{grid-area:est;font-weight:600}
.b-row .row-btn{grid-area:del}
.b-stat{grid-area:stat;justify-self:start;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:600;
  border:1px solid var(--line);background:var(--panel2);color:var(--mid);white-space:nowrap}
.b-stat.b-off{background:rgba(230,180,80,.16);border-color:rgba(230,180,80,.4);color:var(--warn-ink)}
.b-stat.b-ok{background:rgba(55,193,132,.15);border-color:rgba(55,193,132,.35);color:var(--ok-ink)}
.b-stat.b-paid{background:rgba(108,140,255,.12);border-color:rgba(108,140,255,.45);color:var(--accent-ink)}
.b-add{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--line-soft)}
.b-add input{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:14px;min-width:0}
.b-add input:focus{outline:none;border-color:var(--accent)}
.b-add .b-in-lbl{flex:1 1 auto}
.b-add .b-in-est{flex:0 0 88px;text-align:right}
.b-foot{padding:2px 16px 14px;font-size:12px;color:var(--dim)}
.b-empty{padding:12px 16px;font-size:13px;color:var(--dim)}

/* program */
.tl .txt{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.tl .txt .ed{flex:1;min-width:0}
.p-add .p-in-time{flex:0 0 82px;text-align:center}

/* gäster */
.g-name{display:flex;align-items:center;gap:6px;min-width:0}
.g-act{display:flex;align-items:center;gap:2px;flex:0 0 auto}
/* Åldern som ETIKETT, inte emoji: 👶 kunde bara säga barn/inte-barn, och med tre grupper är
   skillnaden mellan tonåring och vuxen precis den man behöver kunna läsa i förbifarten.
   Vuxen är default och tonas ned — det är majoriteten, och det som avviker ska sticka ut. */
.g-alder{border:1px solid var(--line);background:var(--panel2);color:var(--mid);border-radius:999px;
  padding:2px 8px;font-size:10.5px;font-weight:600;line-height:1.5;white-space:nowrap;flex:0 0 auto}
.g-alder.a-vuxen{background:transparent;border-color:var(--line);color:var(--faint);font-weight:500}
.g-alder.a-vuxen:hover{color:var(--mid);border-color:var(--line-strong)}
.g-alder.a-ton{background:rgba(230,180,80,.16);border-color:rgba(230,180,80,.42);color:var(--warn-ink)}
.g-alder.a-barn{background:rgba(108,140,255,.12);border-color:rgba(108,140,255,.42);color:var(--accent-ink)}
/* Andra statsraden: samma rutnät, men tunnare — den svarar på "hur många av varje", inte på
   huvudfrågan "hur många kommer". */
.stats.alder{border-top:0}
.stats.alder .stat{padding:8px 0}
.stats.alder b{font-size:17px;color:var(--txt)}
.g-add select{height:44px;padding:0 10px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:14px;flex:0 0 auto}
.g-add select:focus{outline:none;border-color:var(--accent)}
.g-add{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--line-soft)}
.g-add input[type=text]{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:14px;flex:1 1 130px;min-width:0}
.g-add input:focus{outline:none;border-color:var(--accent)}
.g-add label{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--mid)}

/* underlag */
.d-body{padding:0 0 14px;font-size:13px;white-space:pre-wrap;color:var(--mid)}
.dok{border-top:1px solid var(--line-soft)}
.dok>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:10px;
  min-height:46px;cursor:pointer;font-weight:600;font-size:14px}
.dok>summary::-webkit-details-marker{display:none}
.dok-t{min-width:0}
.d-sum-act{display:flex;align-items:center;gap:4px;flex:0 0 auto;color:var(--dim)}

/* ── Hopfällbara sektioner. Rubriken ÄR knappen: en festsida på mobil blir annars en
   ändlös rulle, och det man inte jobbar med just nu ska gå att lägga undan. ── */
.sec-tog{cursor:pointer;user-select:none}
.sec-head h2{display:flex;align-items:center;gap:8px}
.chev{font-size:11px;color:var(--dim);transition:transform .15s ease;line-height:1}
.chev.stangd{transform:rotate(-90deg)}
/* Avbockat göms bakom "Klart · n". Det gjorda är inte det man ska mötas av. */
details.klart{margin-top:8px}
details.klart>summary{list-style:none;cursor:pointer;padding:8px 0;display:flex;align-items:center;gap:6px}
details.klart>summary::-webkit-details-marker{display:none}
details.klart>summary::after{content:"▾";font-size:11px;color:var(--faint)}
details.klart[open]>summary::after{content:"▴"}

/* ── Checklistan ⇄ Inköpslistan ── */
.flip{display:flex;gap:5px;flex:1;min-width:0;align-items:baseline}
/* 16 px, inte 18: två rubriker + separator + räknare fick inte plats på 390 px och kapades
   till "Checklis… / Inköpslista…". Räknaren till höger göms i stället på små skärmar —
   siffrorna finns ändå i flippen och i kategoriväxlaren. */
.flip button{padding:0;border:0;background:none;font-size:16px;font-weight:650;color:var(--faint);white-space:nowrap}
@media(max-width:439px){ .sec-head .flip ~ .num{display:none} }
.flip button.on{color:var(--txt)}
.flip button:not(.on):hover{color:var(--mid)}
.flip .sep{color:var(--line-strong);font-weight:400;align-self:center}
.chevbtn{border:0;background:none;color:var(--faint);font-size:12px;padding:4px 0 4px 8px;flex:0 0 auto}
.s-row{display:grid;grid-template-columns:26px minmax(0,1fr) auto auto 28px;
  grid-template-areas:"box item tagg qty meny";
  gap:2px 8px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line-soft)}
.s-row .mini.tagg{grid-area:tagg}
.s-row .radmeny{grid-area:meny}
.s-row:last-child{border-bottom:0}
.s-row .box{grid-area:box}
.s-item{grid-area:item;font-size:15px;min-width:0}
.s-qty{grid-area:qty;font-size:13px;color:var(--mid);font-weight:600;white-space:nowrap}


.s-row.done .s-item{color:var(--dim);text-decoration:line-through;text-decoration-color:rgba(139,130,114,.45)}
.s-row.done .s-qty{color:var(--faint)}
/* 🍳 Varan hör till en tillagad rätt. Grön i stället för grå: den är avklarad, men inte
   avbockad av någon i butiken — och den kommer tillbaka om rätten av-markeras. */
.s-row.kokt .s-item{color:var(--ok-ink);text-decoration:line-through;text-decoration-color:rgba(55,193,132,.5)}
.s-row.kokt .s-qty{color:var(--ok-ink);opacity:.75}
.s-row.kokt .box{background:rgba(55,193,132,.15);border-color:rgba(55,193,132,.5);color:var(--ok-ink)}
.s-kokt{display:inline-block;margin-left:6px;font-size:11px;font-weight:700;color:var(--ok-ink);
  background:rgba(55,193,132,.14);border-radius:999px;padding:1px 8px;text-decoration:none}
/* Sorteringsväljaren. Tre lägen, ett tryck: min ordning / butikens gångordning / per rätt. */
/* Rubrikens draghandtag. Liten med flit — det är rubriken man läser, inte greppet — men
   alltid synlig: ett handtag som visas först vid hover finns inte på en telefon.
   touch-action:none, annars blir ett drag en sidscroll. */
.grp-drag{flex:0 0 auto;color:var(--faint);font-size:13px;line-height:1;padding:2px 4px;
  cursor:grab;touch-action:none;user-select:none}
.grp-drag:active{cursor:grabbing;color:var(--champ-ink)}
.slapp-grp{height:3px;background:var(--champ-ink);opacity:.9}
.sortrad{display:flex;gap:6px;margin:2px 0 10px;flex-wrap:wrap}
.sortbtn{border:1px solid var(--line);background:var(--panel);color:var(--dim);border-radius:999px;
  padding:6px 12px;font-size:12px;font-weight:600;font:inherit;font-size:12px}
.sortbtn.on{background:rgba(200,171,119,.16);border-color:rgba(200,171,119,.45);color:var(--champ-ink)}
.grp-h.grp-last .lbl{color:var(--dim)}
.sort-not{font-size:11px;color:var(--faint);padding:10px 0 0;line-height:1.5}
.s-add{display:flex;gap:8px;margin-top:12px}
.s-add input{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:14px;min-width:0}
.s-add input:focus{outline:none;border-color:var(--accent)}
.s-add .s-in-item{flex:1 1 auto}
.s-add .s-in-qty{flex:0 0 82px;text-align:center}

/* ── Rubriker och taggar ──────────────────────────────────────────────────────
   Två axlar som löser olika saker: RUBRIKEN samlar rader ("Lunch", "Middag") och syns som en
   liten överskrift, TAGGEN säger vad raden hör till ("Kantarellpaj") och syns som en färgad
   ruta i kolumnen till höger om titeln. Färgen härleds ur ordet, så ingen färgväljare behövs. */
.grp-h{display:flex;align-items:center;gap:8px;padding:14px 0 4px;border-top:1px solid var(--line-soft)}
.grp-h:first-child{border-top:0;padding-top:4px}
.grp-h .lbl{cursor:text}
.grp-h .n{font-size:11px;color:var(--faint);margin-right:auto}
.grp-add{border:1px solid var(--line);background:var(--panel);color:var(--dim);border-radius:6px;
  width:22px;height:22px;font-size:13px;line-height:1;padding:0;flex:0 0 auto}
.grp-add:hover{border-color:var(--accent);color:var(--accent-ink)}
.mini{max-width:100%;padding:2px 7px;border-radius:6px;font-size:10.5px;line-height:1.5;font-weight:600;
  border:1px solid var(--line);background:var(--panel2);color:var(--mid);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mini.tom{border-style:dashed;border-color:var(--line-strong);color:var(--faint);background:transparent;font-weight:400;padding:2px 6px}
.mini.grp{text-transform:uppercase;letter-spacing:.4px;font-size:9.5px}
.mini.grp.satt{font-size:11px;letter-spacing:0;padding:1px 6px;color:var(--faint);background:transparent;border-color:var(--line)}
.mini.grp.satt:hover{color:var(--accent-ink);border-color:var(--accent)}
/* Taggen på en rad är en ETIKETT, inte en knapp: den bär information man skummar efter, och
   allt som ändrar den bor bakom ⋯. Fast maxbredd i px — i delad vy blev en procentandel av en
   smal kolumn så lite att taggarna kapades till "L…", vilket är sämre än ingen tagg alls. */
.mini.tagg{flex:0 0 auto;max-width:118px;cursor:default}
/* ⋯ ska synas när man letar efter den och försvinna när man läser listan. Därav faint som
   viloläge. Den är också draghandtag, så touch-action:none — ytan är liten med flit, resten
   av raden scrollar fortfarande. */
.radmeny{flex:0 0 auto;width:28px;height:28px;padding:0;border:1px solid transparent;border-radius:var(--r-field);
  background:transparent;color:var(--faint);font-size:15px;line-height:1;display:flex;align-items:center;
  justify-content:center;touch-action:none;cursor:grab}
.radmeny:hover{border-color:var(--line);color:var(--txt);background:var(--panel)}
body.drar .radmeny{cursor:grabbing}
.row.done .mini,.s-row.done .mini{opacity:.5}
.row.done .radmeny,.s-row.done .radmeny{opacity:.5}

/* ── Delad vy: checklista och inköpslista bredvid varandra i samma kort ── */
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;align-items:start}
.split>div{min-width:0}
.split-h{font-size:12px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--dim);
  padding-bottom:8px;margin-bottom:4px;border-bottom:1px solid var(--line)}
.split .row,.split .s-row{padding:8px 0}

.split .row-txt .t,.split .s-item{font-size:13.5px}
.splitbtn{border:1px solid var(--line);background:var(--panel);color:var(--dim);border-radius:var(--r-field);
  width:30px;height:26px;font-size:12px;padding:0;flex:0 0 auto;margin-left:6px}
.splitbtn.on{background:rgba(108,140,255,.12);border-color:rgba(108,140,255,.45);color:var(--accent-ink)}
@media(max-width:899px){ .splitbtn{display:none} }

/* ── Portioner och "har hemma" ── */
.cook-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:13px;color:var(--mid);
  padding:0 0 12px;border-bottom:1px solid var(--line-soft);margin-bottom:4px}
.cook-row .ed{font-weight:650;color:var(--txt);min-width:22px;display:inline-block}
.r-serv{font-size:12px;color:var(--dim);margin:8px 0 6px}
.r-serv .ed{font-weight:600;color:var(--mid)}
.r-serv .fak{color:var(--champ-ink);font-weight:600}
/* En ingrediensrad: statusknappen till vänster är den ENDA ytan som byter status. Texten
   öppnar redigering. Förut var hela raden en knapp, och då bytte man status varje gång man
   ville läsa eller rätta en rad. */
.ing-rad{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line-soft)}
.ing-rad:last-of-type{border-bottom:0}
.ing-st{flex:0 0 auto;width:74px;padding:3px 0;border-radius:6px;font-size:10px;font-weight:700;
  letter-spacing:.3px;text-transform:uppercase;border:1px solid var(--line);background:var(--panel2);
  color:var(--dim);text-align:center;white-space:nowrap}
.ing-st.klar{background:rgba(55,193,132,.15);border-color:rgba(55,193,132,.4);color:var(--ok-ink)}
.ing-txt{flex:1;min-width:0;font-size:13px;line-height:1.45;cursor:text}
.ing-rad.klar .ing-txt{color:var(--dim)}
.ing-rad .row-btn{width:26px;height:26px}
.ing-add{display:flex;gap:6px;margin-top:10px}
.ing-add input{height:40px;padding:0 10px;border:1px solid var(--line);border-radius:var(--r-field);
  background:var(--panel);color:var(--txt);font-size:13px;min-width:0}
.ing-add input:focus{outline:none;border-color:var(--accent)}
.ing-add .ing-in-qty{flex:0 0 76px;text-align:center}
.ing-add .ing-in-item{flex:1 1 auto}
.ing-sum{font-size:11px;color:var(--dim)}
.ing-sum b{color:var(--ok-ink);font-weight:700}
.ing-sum i{font-style:normal;color:var(--warn-ink);font-weight:700}
.ing-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.ing-head .r-btn{width:30px;height:26px}

/* ── Rätten öppnad: ingredienser och utförande ── */
.r-row{cursor:pointer}
.r-detalj{padding:4px 0 14px;border-bottom:1px solid var(--line-soft)}
.r-detalj .lbl{display:block;margin:10px 0 4px}
.r-txt{font-size:13px;color:var(--mid);white-space:pre-wrap;line-height:1.55}
.r-txt.tom{color:var(--faint)}
.r-detalj .btn{height:40px;font-size:13px;margin-top:12px}

/* ── Drag and drop ────────────────────────────────────────────────────────────
   Handtaget ÄR ⇅/+-rutan som redan flyttar raden mellan rubriker — ett klick öppnar
   rubriknamnet, ett drag flyttar raden. Att lägga till ett andra handtag hade gett två
   ikoner för samma sak på varje rad.
   touch-action:none behövs för att ett drag på telefonen inte ska bli en sidscroll; ytan är
   liten med flit, så resten av raden fortfarande scrollar. */
body.drar{cursor:grabbing;user-select:none;-webkit-user-select:none}
.drar-rad{opacity:.35}
/* Spöket följer fingret. position:fixed, så det inte påverkar layouten under. */
#spoke{position:fixed;z-index:60;pointer-events:none;background:var(--panel);border:1px solid var(--accent);
  border-radius:var(--r-field);box-shadow:0 8px 24px rgba(0,0,0,.18);padding:6px 10px;font-size:13px;
  max-width:60vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:.95}
/* Släpplinjen visar exakt var raden hamnar. Utan den är ett drag en gissning. */
.slapp{height:0;border-top:2px solid var(--accent);margin:-1px 0}
.grp-h.slapp-i{background:rgba(108,140,255,.1);border-radius:6px}

/* ── "+"-menyn per lista ──────────────────────────────────────────────────────
   Samlar det som förut var utspritt: ny rad, ny rubrik, ny tagg, klistra in flera. */
.plusbtn{border:1px solid var(--line);background:var(--panel);color:var(--dim);border-radius:var(--r-field);
  width:30px;height:26px;font-size:15px;line-height:1;padding:0;flex:0 0 auto;margin-left:6px}
.plusbtn:hover{border-color:var(--accent);color:var(--accent-ink)}
.split-h{display:flex;align-items:center;justify-content:space-between;gap:8px}
#meny{position:fixed;z-index:70;background:var(--panel);border:1px solid var(--line);
  border-radius:var(--r-field);box-shadow:0 12px 30px rgba(0,0,0,.16);padding:4px;min-width:232px}
#meny button{display:flex;width:100%;align-items:center;gap:10px;background:none;border:0;
  padding:10px 12px;border-radius:6px;font-size:14px;color:var(--txt);text-align:left}
#meny button:hover{background:var(--panel2)}
#meny .mi{flex:0 0 18px;text-align:center}
#meny hr{border:0;border-top:1px solid var(--line-soft);margin:4px 6px}

/* ── Massinmatning ────────────────────────────────────────────────────────────
   91 rader lades in via API:t, inte för hand. Rutan gör det familjen redan gör i en
   anteckning — en rad per sak — till en lista. */
#massa{position:fixed;inset:0;z-index:80;background:rgba(43,39,35,.34);display:flex;
  align-items:flex-end;justify-content:center;padding:0}
#massa .ark{background:var(--panel);border:1px solid var(--line);border-radius:14px 14px 0 0;
  width:100%;max-width:560px;padding:16px;display:flex;flex-direction:column;gap:10px;max-height:88dvh}
#massa h3{margin:0;font-size:16px;font-weight:650}
#massa textarea{flex:1;min-height:180px;resize:vertical;font:inherit;font-size:14px;line-height:1.5;
  padding:10px;border:1px solid var(--line);border-radius:var(--r-field);background:var(--panel);color:var(--txt)}
#massa textarea:focus{outline:none;border-color:var(--accent)}
#massa .rad{display:flex;gap:8px}
#massa .rad .btn{flex:1}
@media(min-width:900px){ #massa{align-items:center} #massa .ark{border-radius:14px} }

/* ── Aktivitetsfeeden i hjärtat ───────────────────────────────────────────────
   Feeden låg i checklistan och gällde bara den. Nu är den sidans gemensamma puls, och
   hjärtat får två kolumner på bredden — på telefonen ligger den under, hopfälld. */
.heart-in{text-align:center}
@media(min-width:900px){
  .heart-in{display:grid;grid-template-columns:1fr 260px;gap:24px;align-items:center;text-align:center}
  .heart-mitt{min-width:0}
  .feed{border-left:1px solid var(--champ-line);padding-left:20px}
}
.feed{text-align:left}
.feed .lbl{display:block;margin-bottom:8px}
.feed-lista{max-height:168px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}
/* Listan klipper sin sista rad mitt i texten, vilket såg ut som ett fel snarare än som "det
   finns mer". Toningen sätts BARA när det faktiskt går att scrolla (klassen sätts i wire()),
   annars hade den sista raden bleknat även i en kort feed. */
.feed-lista.mer{mask-image:linear-gradient(to bottom,#000 calc(100% - 22px),transparent);
  -webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 22px),transparent)}
.feed-rad{font-size:12px;line-height:1.4;color:var(--mid)}
.feed-rad b{font-weight:650;color:var(--txt)}
.feed-rad span{color:var(--faint)}
.feed-tom{font-size:12px;color:var(--faint)}
@media(max-width:899px){
  .feed{margin-top:16px;padding-top:14px;border-top:1px solid var(--champ-line)}
  .feed-lista{max-height:132px}
}

/* ── Budget: den automatiska inköpsraden ──────────────────────────────────────
   En post som räknas fram, inte skrivs in. Den är expanderbar för att en summa utan
   uppdelning är omöjlig att lita på — man vill se VAD som kostar. */
.b-auto{border-top:1px solid var(--line-soft)}
.b-auto>summary{list-style:none;display:grid;grid-template-columns:1fr auto 30px;
  grid-template-areas:"lbl est del" "stat stat stat";gap:2px 10px;align-items:center;
  padding:10px 16px;cursor:pointer}
.b-auto>summary::-webkit-details-marker{display:none}
.b-auto .b-est{grid-area:est}
.b-auto .b-lbl{grid-area:lbl}
.b-auto .b-stat{grid-area:stat}
.b-detalj{padding:0 16px 12px}
.b-drad{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;padding:4px 0;
  border-bottom:1px solid var(--line-soft);color:var(--mid)}
.b-drad:last-child{border-bottom:0}
.b-drad.klar{color:var(--faint);text-decoration:line-through;text-decoration-color:rgba(139,130,114,.4)}
.b-drad .kr{flex:0 0 auto;font-weight:600}
.b-drad .kr.ingen{color:var(--faint);font-weight:400}
.b-dgrp{font-size:10.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--dim);
  font-weight:700;padding:10px 0 2px}
.b-dfot{font-size:11px;color:var(--faint);padding-top:8px;line-height:1.5}
@media(min-width:900px){
  .b-auto>summary{grid-template-columns:1fr auto auto 30px;grid-template-areas:"lbl stat est del";gap:10px}
}

.sticky{position:sticky;top:0;z-index:10;background:rgba(250,247,242,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);display:none;align-items:center;justify-content:space-between;padding:10px 16px;margin:-16px -16px 0}
@media(min-width:900px){
  .wrap{padding:22px;gap:16px}
  /* min-width:0 på BÅDA kolumnerna. Utan det får en 1.45fr-kolumn aldrig bli smalare än sitt
     min-content, och taggraden (tolv chips i inköpsläget) satte då kolumnens bredd — hela
     rutnätet spillde ut förbi .wrap och blev bredare än hjärtat ovanför. Det såg ut som att
     hjärtat var för smalt; i själva verket var det raden under som rymde. */
  .grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:16px;align-items:start}
  .gcol{display:flex;flex-direction:column;gap:16px;min-width:0}
  .seg{display:none}
  .row{padding:9px 0}.box{width:22px;height:22px}.row-txt .t{font-size:14px}
  .b-row{grid-template-columns:1fr auto auto 30px;grid-template-areas:"lbl stat est del";gap:10px}
}
@media(max-width:899px){ .desk-cats{display:none} }
</style>
</head>
<body>
<div id="gate">
  <div class="invite card">
    <div class="invite-in">
      <div class="mono num">40</div>
      <div class="lbl" id="g-date">Laddar…</div>
      <h1 style="margin:8px 0 0;font-size:24px;font-weight:650" id="g-title">&nbsp;</h1>
      <div style="font-size:13px;color:var(--dim);margin-top:4px" id="g-sub"></div>
      <div class="rule"></div>
      <div style="font-size:14px">Skriv koden från inbjudan, så öppnas sidan.</div>
      <input id="code" inputmode="numeric" autocomplete="off" placeholder="KOD" />
      <button class="btn primary wide" id="g-go" style="margin-top:12px;height:48px">Öppna kalaset</button>
      <div style="font-size:12px;color:var(--dim);margin-top:12px" id="g-help">Ingen kod? Skriv till Calle eller Jossi.</div>
    </div>
  </div>
  <div style="font-size:11px;color:var(--faint)">carlpalmquist.com</div>
</div>

<div class="wrap" id="app" style="display:none"></div>
<div id="toast"><span id="toast-txt"></span><button id="toast-undo">Ångra</button></div>

<script define:vars={{ slug }}>
// S.open håller <details>-lägena. Varje skrivning ritar om HELA appen, så utan detta
// slog Budget och underlagen igen mitt i att någon skrev i dem.
const S = { pw: "", ev: null, log: [], cat: null, tag: null, stag: null, me: "", undo: null, open: {}, sedd: 0, vy: "check",
  // Är "✓ Färdigt"-gruppen utfälld? Per lista, eftersom båda syns samtidigt i delad vy.
  klartOppen: {},
  // Inköpslistans ordning: "min" (egna rubriker + dragen ordning), "butik" (gångordningen i
  // en vanlig svensk matbutik) eller "ratt" (en rubrik per rätt). Sparas lokalt per person —
  // det är en vy-inställning, inte en gemensam sanning, och den som står i butiken vill ha
  // butiksordningen utan att ändra listan för alla andra.
  sortShop: (() => { try { return localStorage.getItem("fest:sortshop") || "min"; } catch (e) { return "min"; } })(),
  // Id på den rätt vars ⋯-meny är öppen. Fyra knappar per rätt blev en knappvägg på mobilen;
  // valen bor nu bakom en knapp. Ren UI-state, sparas aldrig.
  rmenu: null };
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const api = async (path, opts) => { const r = await fetch(path, opts); const d = await r.json().catch(() => ({})); if (!r.ok) throw new Error(d.error || r.status); return d; };
// Felkoder från Workern på svenska. En gäst ska få veta VAD som gick fel, inte se "bad_date".
const FEL = {
  bad_date: "Skriv dagen som 29/8 eller 2026-08-29.",
  bad_list: "Okänd lista — ladda om sidan.",
  empty: "Skriv något först.",
  full: "Listan är full. Ta bort några rader först.",
  finns_redan: "Den varan finns redan på inköpslistan.",
  rate_limited: "För många ändringar just nu. Vänta en stund.",
  kv_full: "Molnlagret har nått dagens gräns — ändringen sparades INTE.",
  unauthorized: "Koden gäller inte längre — ladda om sidan.",
};
const cats = () => (S.ev.categories && S.ev.categories.length) ? S.ev.categories : ["Inhandling", "Fixa"];
// Gästlägen. ej_bjuden är default för allt okänt: en gäst utan svar ska aldrig kunna se ut
// som ett nej. NÄSTA-kedjan är livscykeln, och nej vänder tillbaka till början.
const GST = {
  ej_bjuden: { l: "Ej bjuden", c: "ejbj", next: "väntar" },
  "väntar": { l: "Väntar", c: "vantar", next: "ja" },
  ja: { l: "Ja", c: "ja", next: "nej" },
  nej: { l: "Nej", c: "", next: "ej_bjuden" },
};
// ── Radordning ────────────────────────────────────────────────────────────────
// `ord` sätts av drag and drop (Workerns kind=move numrerar om hela listan). En rad UTAN ord
// är oplacerad och sorteras SIST — nypublicerade rader från pappen ska hamna i slutet, inte
// hoppa överst i en lista familjen just sorterat om. MAX_SAFE_INTEGER i stället för Infinity:
// Infinity - Infinity är NaN, och en jämförare som ger NaN sorterar godtyckligt.
const ordAv = (x) => { const n = Number(x && x.ord) || 0; return n > 0 ? n : Number.MAX_SAFE_INTEGER; };
const iOrd = (a) => a.slice().sort((x, y) => ordAv(x) - ordAv(y));
// Tre åldersgrupper. SPEGEL av ALDRAR i functions/api/fest40.js — ändras den ena måste den
// andra ändras. `barn` finns kvar som härlett fält för pappen och räknarna; läs alltid alder.
// Vuxen är default för allt okänt: en gäst utan uppgift ska inte tyst räknas som barn.
const ALDER = {
  vuxen: { l: "Vuxen", kort: "Vuxen", c: "a-vuxen", next: "tonaring" },
  tonaring: { l: "Tonåring", kort: "Tonåring", c: "a-ton", next: "barn" },
  barn: { l: "Barn", kort: "Barn", c: "a-barn", next: "vuxen" },
};
const alderAv = (g) => (g && ALDER[g.alder]) ? g.alder : ((g && g.barn) ? "barn" : "vuxen");
const raknaAlder = (gaster) => gaster.reduce((n, g) => { n[alderAv(g)]++; return n; }, { vuxen: 0, tonaring: 0, barn: 0 });
const plan = () => iOrd(Array.isArray(S.ev.plan) ? S.ev.plan : []);
const shop = () => iOrd(Array.isArray(S.ev.shop) ? S.ev.shop : []);
const listAv = (lista) => (lista === "shop" ? shop() : plan());
// 🍳 TILLAGAT. Varje inköpsrad hör redan till EN rätt (tag + fromRecipe): hämtningen lägger in
// en rad per rätt, så tre rätter som var för sig behöver 1 liter mjölk ger tre rader. Därför
// räcker det att stryka raderna som hör till den lagade rätten — bara den mängden markeras,
// de andra rätternas mjölk står kvar. HÄRLETT, aldrig skrivet: raderna får ingen done-flagga,
// så "Ångra tillagat" ger tillbaka listan exakt som den var (någon kan ha bockat av hälften
// för hand innan rätten lagades, och den handpåläggningen får inte skrivas över).
// fromRecipe är den säkra kopplingen; taggen är fallback för rader som hämtades in innan
// fältet fanns, eller som speglats in från pappen.
// 🛒 BUTIKSORDNING. Hyllorna kommer FRÅN PAPPEN i eventet (ev.shelves), precis som priserna —
// ingen andra kopia här. Ordningen i arrayen ÄR gångordningen i butiken.
// Matchningen är en spegel av festShelfOf i pappens public/js/inkops-data.js: LÄNGSTA träffade
// nyckelordet vinner, inte det första. Svensk sammansättning gör förstaträff otillförlitlig —
// "te" finns i "servetter", "ost" i "ostbågar", "is" i "ris". Ändras regeln där måste den
// ändras här. Saknas ev.shelves (eventet inte ompublicerat än) faller vyn tillbaka på "min".
const hyllor = () => (Array.isArray(S.ev.shelves) ? S.ev.shelves : []);
const hyllaFor = (namn) => {
  const hay = String(namn == null ? "" : namn).toLowerCase();
  let bast = null, langd = 0;
  for (const h of hyllor()) for (const k of (h.k || [])) if (k.length > langd && hay.includes(k)) { bast = h; langd = k.length; }
  return bast;
};
const koktaRatter = () => ((S.ev && S.ev.recipes) || []).filter((r) => r.cooked && r.status !== "forslag");
const arKokt = (x) => {
  const k = koktaRatter();
  if (!k.length) return false;
  if (x.fromRecipe && k.some((r) => r.id === x.fromRecipe)) return true;
  const t = String(x.tag || "").trim().toLowerCase();
  return !!t && k.some((r) => String(r.title || "").trim().toLowerCase() === t);
};
// Sektionerna är öppna som default; S.open minns bara avvikelserna.
const oppen = (k) => S.open[k] !== false;
// Portionsskalning. SPEGEL av samma funktioner i functions/api/fest40.js — ändras den ena
// måste den andra ändras, annars visar sidan en mängd och inköpslistan får en annan.
function talAv(t) {
  let m = t.match(/^(\d+(?:[.,]\d+)?)\s+(\d+)\/(\d+)/);
  if (m) return { v: parseFloat(m[1].replace(",", ".")) + Number(m[2]) / Number(m[3]), len: m[0].length };
  m = t.match(/^(\d+)\/(\d+)/);
  if (m) return { v: Number(m[1]) / Number(m[2]), len: m[0].length };
  m = t.match(/^(\d+(?:[.,]\d+)?)/);
  return m ? { v: parseFloat(m[1].replace(",", ".")), len: m[0].length } : null;
}
function rundaMangd(v) {
  if (!isFinite(v) || v <= 0) return "0";
  if (v >= 100) return String(Math.round(v / 10) * 10);
  if (v >= 10) return String(Math.round(v));
  if (v >= 1) return String(Math.round(v * 2) / 2).replace(".", ",");
  return String(Math.round(v * 10) / 10).replace(".", ",");
}
// EN mängd, alltid som decimaltal. Beslut 2026-08-27 (Calle): inga bråk och inga intervall i
// resultatet. "1/2 dl" blir "0,5 dl", och "2–3 dl" blir "3 dl" — i en butik är ett spann inget
// man kan handla efter, och för en fest är det övre talet det som räcker. Vi normaliserar även
// när ingen skalning sker (faktor 1), så texten aldrig visar ett format man inte kan räkna med.
// Receptets EGEN text rörs inte — den ligger kvar rå bakom ✎.
function skalaQty(qty, f) {
  const t = String(qty || "").trim();
  if (!t) return t;
  const n = talAv(t);
  if (!n) return t;
  let v = n.v;
  let rest = t.slice(n.len);
  const r = rest.match(/^\s*[-–]\s*(\d+(?:[.,]\d+)?(?:\s+\d+\/\d+)?|\s*\d+\/\d+)/);
  if (r) {                                   // intervall: ta det övre talet och släng spannet
    const ovre = talAv(r[1].trim());
    if (ovre) v = ovre.v;
    rest = rest.slice(r[0].length);
  }
  return (rundaMangd(v * (f || 1)) + rest).replace(/\s+/g, " ").trim();
}
// Rättens eget antal ärver festens om inget eget satts. Spegel av Workern.
const lagarAv = (r) => Number(r && r.portions) || Number(S.ev.info && S.ev.info.cook) || 0;
const skalfaktor = (r) => {
  const lagar = lagarAv(r);
  const bas = Number(r && r.servings) || 0;
  return (lagar > 0 && bas > 0) ? lagar / bas : 1;
};
const haveKey = (rad) => String(rad || "").toLowerCase().replace(/\s+/g, " ").trim();
// Taggfärgen härleds ur ordet. Ingen färgväljare att fylla UI:t med, och samma tagg får samma
// färg i båda listorna — det är hela poängen med att kunna skumma dem i en butik.
const TAGGFARGER = [
  ["rgba(108,140,255,.14)", "rgba(108,140,255,.45)", "#4d68d8"],
  ["rgba(55,193,132,.15)", "rgba(55,193,132,.4)", "#2f9e6e"],
  ["rgba(230,180,80,.2)", "rgba(230,180,80,.45)", "#a1782a"],
  ["rgba(207,85,112,.13)", "rgba(207,85,112,.38)", "#c04a66"],
  ["rgba(150,110,215,.14)", "rgba(150,110,215,.4)", "#7a56bd"],
  ["rgba(80,175,195,.16)", "rgba(80,175,195,.42)", "#2c7f92"],
];
function taggStil(t) {
  let h = 0; for (const c of String(t)) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const [bg, br, ink] = TAGGFARGER[h % TAGGFARGER.length];
  return `background:${bg};border-color:${br};color:${ink}`;
}
// Radens högerkant. TVÅ saker, inte fem (Calle 2026-08-28: "generellt lite överplottrat …
// för sådana som bara gillar att använda excel eller word").
//
// TAGGEN är INFORMATION, inte en kontroll — den är det man skummar efter i en butik, så den
// står kvar som en färgad etikett. Men bara när den ÄR satt: de tomma streckade "+"-rutorna
// fanns på varje rad som inte hade en tagg, alltså mest plotter i utbyte mot en affordance
// man ändå hittar en gång och sedan minns.
//
// ALLT SOM ÄNDRAR RADEN bor bakom ⋯: rubrik, tagg, inköpslistan, texten, ta bort. Knappen är
// dessutom DRAGHANDTAGET (tryck = meny, dra = flytta), precis som ⇅-rutan var — annars hade
// drag and drop tappat sitt grepp när rutan togs bort.
const radSlut = (lista, rad) => `${rad.tag ? `<span class="mini tagg" style="${taggStil(rad.tag)}" title="Tagg: ${esc(rad.tag)}">${esc(rad.tag)}</span>` : ""}
  <button class="radmeny" data-radmeny="${lista}:${esc(rad.id)}" title="Rubrik, tagg, ändra, ta bort — håll och dra för att flytta raden" aria-label="Fler val för raden">⋯</button>`;
// Taggraden, delad av checklistan och inköpslistan.
// TAL = ANTAL KVAR, inte totalen. En tagg vars siffra är noll bär ingen information alls men
// tar full bredd i en rad som redan scrollar — och med tolv taggar var det halva raden.
// Därför samlas de FÄRDIGA taggarna bakom EN chip ("✓ Färdigt 4") som fälls ut när man vill
// åt dem. Inget göms permanent: allt går fortfarande att filtrera på, det ligger bara ett
// tryck bort i stället för att konkurrera om plats med det som är kvar att göra.
// UNDANTAG: den AKTIVA taggen står alltid kvar i huvudraden, även när den blivit färdig —
// annars försvinner filtret man just satte, mitt framför ögonen på en.
function taggRad(lista, poster, aktiv, attr) {
  if (!poster.length) return "";
  const klara = poster.filter((x) => x.kvar === 0 && x.tag !== aktiv);
  const kvar = poster.filter((x) => !klara.includes(x));
  const oppen = !!S.klartOppen[lista];
  const chip = (x) => {
    const pa = aktiv === x.tag;
    const fardig = x.kvar === 0;
    return `<button class="chip${pa ? " on" : ""}${fardig && !pa ? " klar" : ""}" data-${attr}="${esc(x.tag)}"${
      pa ? "" : ` style="${taggStil(x.tag)}"`}>${esc(x.tag)} ${pa ? "✕" : fardig ? "✓" : x.kvar}</button>`;
  };
  // "Alla" och "Färdigt" står FÖRST, före taggarna. Båda är fack, inte taggar — och raden
  // scrollar vågrätt: låg Färdigt sist hamnade den utanför skärmen på en telefon, alltså
  // gömd bakom precis den scroll den var till för att slippa.
  return `<div class="chips"><button class="chip${aktiv ? "" : " on"}" data-${attr}="">Alla</button>${
    klara.length ? `<button class="chip klargrupp${oppen ? " on" : ""}" data-klart="${esc(lista)}" title="${
      oppen ? "Dölj de färdiga taggarna" : `${klara.length} taggar där allt är avbockat`}">✓ Färdigt ${oppen ? "✕" : klara.length}</button>` : ""}${
    kvar.map(chip).join("")}</div>${
    oppen && klara.length ? `<div class="chips klarrad">${klara.map(chip).join("")}</div>` : ""}`;
}

// Gruppera på rubrik.
// ORDNINGEN ÄR RADERNAS (2026-08-29). En rubrik har ingen egen post i datan — en grupp är bara
// de rader som bär samma `group`, och sektionens plats är alltså där dess första rad ligger.
// Det gör hela sektionen dragbar utan ett andra ordningsbegrepp som kan säga emot radernas.
// (Förut sorterades grupper kronologiskt på deadline, annars alfabetiskt. Den automatiken gick
// inte att styra: drog man om en sektion hoppade den tillbaka. Dragen ordning slår gissad.)
// Rader UTAN rubrik hamnar sist under "Övrigt" — annars låg 30 osorterade varor före hela den
// indelning man just gjort. Har ingen rad någon rubrik visas ingen överskrift alls.
// `alla` = hela listan i ord-ordning, `rader` = det som faktiskt visas (filtrerat på kategori,
// tagg, avbockat). ORDNINGEN MÅSTE RÄKNAS PÅ HELA LISTAN. Räknas den på det filtrerade urvalet
// får sektionerna en annan inbördes ordning på skärmen än den workern numrerar om efter, och
// ett sektionsdrag landar då någon annanstans än där man släppte. Bet 2026-08-29: "Hushåll"
// släpptes överst och hamnade näst överst, med en avbockad sektion före sig.
function grupperaRader(rader, alla) {
  const utan = rader.filter((x) => !x.group);
  const kalla = Array.isArray(alla) && alla.length ? alla : rader;
  const finns = new Set(rader.map((x) => x.group).filter(Boolean));
  const namn = [];
  for (const x of kalla) if (x.group && finns.has(x.group) && !namn.includes(x.group)) namn.push(x.group);
  const ut = namn.map((g) => [g, rader.filter((x) => x.group === g)]);
  if (utan.length) ut.push([namn.length ? "Övrigt" : "", utan]);
  return ut.filter(([, r]) => r.length);
}
// "+" i rubriken lägger en rad DIREKT i gruppen. Utan den blir en indelad lista tungrodd:
// man lägger till raden längst ner och får sedan klicka upp den i rätt grupp, varje gång.
// Rubrik i en HÄRLEDD ordning (butik/per rätt). Ser likadan ut men bär varken data-grpname
// (omdöpning + släppmål) eller +-knapp: gruppen finns inte i datan, den räknas fram.
const grpRubrikLast = (namn, n) => namn
  ? `<div class="grp-h grp-last"><span class="lbl">${esc(namn)}</span><span class="n num">${n}</span></div>`
  : "";
const grpRubrik = (lista, namn, n) => namn
  ? `<div class="grp-h" data-grph="${lista}:${esc(namn)}">
      <span class="grp-drag" data-grpdrag="${lista}:${esc(namn)}" title="Håll och dra för att flytta HELA sektionen med alla dess rader" aria-label="Flytta sektionen">⠿</span>
      <span class="lbl" data-grpname="${lista}:${esc(namn)}" title="Dubbelklicka för att döpa om rubriken">${esc(namn)}</span>
      <span class="n num">${n}</span>
      <button class="grp-add" data-grpadd="${lista}:${esc(namn)}" title="Lägg till en rad under ${esc(namn)}" aria-label="Lägg till här">+</button></div>`
  : "";

// ── Prisestimat för inköpslistan ──────────────────────────────────────────────
// Prislistan KOMMER FRÅN PAPPEN i eventet (ev.prices), tillsammans med plural-tabellen.
// Sidan har alltså ingen egen kopia — den bor i pappens public/js/inkops-data.js. Skälet att
// sidan ändå RÄKNAR själv: familjen lägger till och stryker varor här hela tiden, så en färdig
// summa från pappen hade varit inaktuell i samma sekund den skickades.
// Har eventet ännu inte publicerats om efter den här ändringen saknas ev.prices, och då visas
// ingen estimatrad alls — hellre ingen siffra än en påhittad.
const priser = () => (Array.isArray(S.ev.prices) ? S.ev.prices : []);
function varuNyckel(n) {
  const t = String(n == null ? "" : n).toLowerCase().replace(/[.,;:!?]/g, "").replace(/\s+/g, " ").trim();
  const pl = (S.ev.plural && typeof S.ev.plural === "object") ? S.ev.plural : {};
  return pl[t] || t;
}
// Första träff vinner — listan är ordnad specifik → generisk ("paprikapulver" före "paprika").
// Både råtexten och den plural-fällda nyckeln prövas: "paprikor".includes("paprika") är falskt.
function prisPost(namn) {
  const hay = String(namn == null ? "" : namn).toLowerCase(), fold = varuNyckel(namn);
  for (const p of priser()) if ((p.k || []).some((k) => hay.includes(k) || fold.includes(k))) return p;
  return null;
}
// Enheterna, per FAMILJ. Familjerna får aldrig korsas: en viktmängd får bara prissättas med
// kg/l-pris och en styckmängd bara med st-pris. Bet i pappen 2026-08-27 — "40 g färsk persilja"
// föll igenom till örtkrukans styckpris och blev 40 krukor = 1000 kr.
const ENH_VIKT = { g: 1, gram: 1, hg: 100, kg: 1000 };
const ENH_VOL = { ml: 1, cl: 10, dl: 100, l: 1000, liter: 1000, msk: 15, tsk: 5, krm: 1 };
const ENH_ST = ["st", "styck", "stycken", "fl", "flaska", "flaskor", "pkt", "paket", "burk", "burkar",
  "påse", "påsar", "knippe", "klyfta", "klyftor", "skiva", "skivor", "port", "näve", "kruka", "krukor"];
// "400 g" / "8 fl" / "2 dl" / "3" → { fam, base, raw }. base är gram resp. ml; raw är antalet.
function mangdAv(qty) {
  const t = String(qty == null ? "" : qty).trim().toLowerCase();
  if (!t) return null;
  const n = talAv(t);
  if (!n) return null;
  const enhet = t.slice(n.len).trim().replace(/\.$/, "").split(/\s+/)[0] || "";
  if (ENH_VIKT[enhet] != null) return { fam: "vikt", base: n.v * ENH_VIKT[enhet], raw: n.v };
  if (ENH_VOL[enhet] != null) return { fam: "vol", base: n.v * ENH_VOL[enhet], raw: n.v };
  if (!enhet || ENH_ST.includes(enhet)) return { fam: "st", base: 0, raw: n.v };
  return { fam: "st", base: 0, raw: n.v };     // okänd enhet: räkna som antal, aldrig som vikt
}
// Pris för EN inköpsrad. `seenBas` gör att en schablonvara (salt, peppar, kryddor) debiteras
// EN gång i hela listan — man köper en burk peppar, inte en per rad som råkar nämna peppar.
// Returnerar { kr } eller null när varan inte kan prissättas (den räknas då synligt bort).
function radPris(rad, seenBas) {
  const post = prisPost(rad.item);
  if (!post) return null;
  const basEnGang = () => {
    if (post.bas == null) return null;
    if (seenBas) { if (seenBas.has(post)) return 0; seenBas.add(post); }
    return post.bas;
  };
  const m = mangdAv(rad.qty);
  if (!m) {
    const b = basEnGang();
    const kr = b != null ? b : (post.st != null ? post.st : null);
    return kr == null ? null : { kr };
  }
  if (m.fam === "vikt" || m.fam === "vol") {
    // Matvarors densitet ligger nära 1 kg/l, så kg-pris duger för volym och tvärtom — men ETT
    // styckpris får aldrig användas här.
    const per = m.fam === "vikt" ? (post.kg != null ? post.kg : post.l) : (post.l != null ? post.l : post.kg);
    if (per != null) return { kr: (m.base / 1000) * per };
    const b = basEnGang();
    return b == null ? null : { kr: b };
  }
  if (post.st != null) return { kr: Math.ceil(m.raw - 1e-9) * post.st };
  const b = basEnGang();
  return b == null ? null : { kr: b };
}
// Hela listan i ETT svep, med färsk seenBas. En enstaka rad går inte att räkna om för sig:
// kryddschablonen debiteras en gång, så delresultatet beror på ordningen.
function shopEstimat(rader) {
  const seen = new Set();
  const per = rader.map((r) => ({ rad: r, pr: radPris(r, seen) }));
  const rnd = (n) => Math.round(n / 10) * 10;
  let tot = 0, kvar = 0, utan = 0;
  for (const x of per) {
    if (!x.pr) { utan++; continue; }
    tot += x.pr.kr;
    if (!x.rad.done) kvar += x.pr.kr;
  }
  return { per, tot: rnd(tot), kvar: rnd(kvar), utan };
}

// ---- datum ----
const DAYS = ["sön","mån","tis","ons","tors","fre","lör"];
const midnight = (d) => { const x = new Date(d); x.setHours(0,0,0,0); return x; };
const daysTo = (iso) => { if (!iso) return null; const d = midnight(new Date(iso)), t = midnight(new Date()); return Math.round((d - t) / 864e5); };
function dueLabel(iso) {
  const n = daysTo(iso);
  if (n == null) return { t: "", c: "" };
  if (n < 0) return { t: n === -1 ? "i går" : `${-n} d sen`, c: "late" };
  if (n === 0) return { t: "idag", c: "today" };
  const d = new Date(iso);
  return { t: `${DAYS[d.getDay()]} ${d.getDate()}/${d.getMonth() + 1}`, c: "" };
}
// Programmets dagrubriker. Dagen skrivs ut i klartext ("lördag 29 augusti") eftersom rubriken
// ska gå att läsa i förbifarten — "2026-08-29" säger inget om vilken dag i helgen det är.
const DAGAR = ["söndag", "måndag", "tisdag", "onsdag", "torsdag", "fredag", "lördag"];
const MANADER = ["januari", "februari", "mars", "april", "maj", "juni", "juli", "augusti",
  "september", "oktober", "november", "december"];
function dagRubrik(iso) {
  const d = new Date(String(iso) + "T12:00:00");
  if (isNaN(d)) return String(iso || "");
  const n = daysTo(iso);
  const bas = `${DAGAR[d.getDay()]} ${d.getDate()} ${MANADER[d.getMonth()]}`;
  return n === 0 ? `${bas} — idag` : n === 1 ? `${bas} — i morgon` : bas;
}
// Kort form till chipet på raden: "29/8".
const dagKort = (iso) => { const d = new Date(String(iso) + "T12:00:00"); return isNaN(d) ? "" : `${d.getDate()}/${d.getMonth() + 1}`; };

// ---- grind ----
async function load(pw) {
  const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&pw=${encodeURIComponent(pw || "")}`);
  S.pw = pw || ""; S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
  if (!S.cat) S.cat = cats()[0];
  try { localStorage.setItem("fest40:pw", S.pw); } catch (e) {}
  $("gate").style.display = "none"; $("app").style.display = "";
  if (!S.me) askName();
  draw();
}
function askName() {
  let n = ""; try { n = localStorage.getItem("fest40:me") || ""; } catch (e) {}
  if (!n) { n = (prompt("Vem är du? (visas vid dina ändringar)") || "").trim().slice(0, 40); try { localStorage.setItem("fest40:me", n); } catch (e) {} }
  S.me = n || "Någon";
}
async function tryOpen() {
  const v = $("code").value.trim();
  try { await load(v); }
  catch (e) {
    const inv = document.querySelector(".invite");
    inv.classList.remove("shake"); void inv.offsetWidth; inv.classList.add("shake");
    $("g-help").textContent = e.message === "rate_limited" ? "För många försök, vänta en stund." : "Hm, den koden stämmer inte. Kolla inbjudan igen.";
  }
}
$("g-go").onclick = tryOpen;
$("code").addEventListener("keydown", (e) => { if (e.key === "Enter") tryOpen(); });

// ---- skrivningar ----
// Hämta om hela eventet från servern. Används både när något gått fel och av pollningen.
async function hamta() {
  const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&pw=${encodeURIComponent(S.pw)}`);
  S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
  draw();
}
async function write(kind, payload, silent) {
  try {
    const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&kind=${kind}`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(Object.assign({ pw: S.pw, name: S.me }, payload)),
    });
    S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
    // Rita INTE om medan någon har ett fält öppet. Svaret på en tidigare skrivning kan landa
    // precis efter att man öppnat en omdöpning, och ompaintningen slängde då bort texten.
    // Pollningen har samma spärr; här gäller den även ens egna skrivningar.
    if (!document.querySelector(".t-edit")) draw();
  } catch (e) {
    // En optimistisk ändring som INTE gick igenom får aldrig bli kvar på skärmen. På ett delat
    // verktyg är den då ett påstående om att alla ser samma sak — och det gör de inte.
    // Tysta skrivningar (avbockning, gäststatus) syntes förut aldrig när de misslyckades.
    if (!silent) alert(FEL[e.message] || ("Kunde inte spara: " + e.message));
    else showToast(e.message === "kv_full"
      ? "Molnlagret är fullt för idag — ändringen sparades INTE"
      : "Kunde inte spara — hämtar om sidan");
    await hamta().catch(() => draw());
  }
}

// ── Flera användare i samma vy ────────────────────────────────────────────────
// Utan pollning ser Calle, Jossi och mamma varsin frusen ögonblicksbild tills de laddar om,
// och tror att de tittar på samma lista när de inte gör det. Vi ritar bara om när eventet
// FAKTISKT ändrats (updatedAt), och aldrig medan någon håller på att skriva — en ompaintning
// mitt i en mening hade slängt bort texten.
const POLL_MS = 15000;
function upptagen() {
  if (document.querySelector(".t-edit")) return true;
  const a = document.activeElement;
  if (a && (a.tagName === "INPUT" || a.tagName === "TEXTAREA")) return true;
  return [...document.querySelectorAll("#app input")].some((i) => i.type !== "checkbox" && i.value.trim());
}
async function poll() {
  if (document.hidden || !S.ev || upptagen()) return;
  try {
    const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&pw=${encodeURIComponent(S.pw)}`);
    if ((d.event.updatedAt || 0) === S.sedd) return;
    S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
    draw();
  } catch (e) {}                       // nätstrul ska aldrig döda sidan man står och jobbar i
}
setInterval(poll, POLL_MS);
// En flik som legat öppen länge kör fortfarande den KOD den laddades med. Pollningen håller
// datan färsk, inte sidan — så mamma kunde sitta kvar i en gammal version utan att veta om det.
// HTML:en är max-age=0 och CSS/JS har fingeravtryck i filnamnet, så en omladdning räcker; det
// behövs ingen hard refresh och ingen extra trafik. Vi laddar bara om när fliken varit dold
// länge och ingen står mitt i en redigering. Tidstämpeln i sessionStorage, inte i en variabel,
// så beteendet går att testa.
const OMLADD_EFTER = 30 * 60 * 1000;
const DOLD_KEY = "fest40:dold";
document.addEventListener("visibilitychange", () => {
  try {
    if (document.hidden) { sessionStorage.setItem(DOLD_KEY, String(Date.now())); return; }
    const sedan = Number(sessionStorage.getItem(DOLD_KEY) || 0);
    sessionStorage.removeItem(DOLD_KEY);
    if (sedan && Date.now() - sedan > OMLADD_EFTER && !upptagen()) return location.reload();
  } catch (e) {}
  poll();
});
function toggle(id) {
  const it = plan().find((p) => p.id === id); if (!it) return;
  const wasDone = it.done;
  it.done = !it.done; draw();                       // optimistiskt, känns direkt under tummen
  write("toggle", { id }, true);
  if (!wasDone) showToast(`”${it.text}” avbockad`, () => write("toggle", { id }, true));
}
// Redigering på plats, delad av alla fält på sidan. Enter sparar, Esc ångrar, klick utanför
// sparar. I flerradigt läge (underlagens textkropp) gör Enter radbrytning och ⌘/Ctrl+Enter sparar.
// allowEmpty: en tom TITEL är alltid ett misstag, men ett tömt underlag är ett giltigt val.
function editable(el, value, onSave, opts) {
  opts = opts || {};
  if (el.querySelector("input,textarea")) return;
  const before = String(value == null ? "" : value);
  const prevHtml = el.innerHTML;
  const inp = document.createElement(opts.multi ? "textarea" : "input");
  inp.className = "t-edit"; inp.value = before;
  if (opts.multi) inp.rows = Math.min(20, Math.max(6, before.split("\n").length + 2));
  el.textContent = ""; el.appendChild(inp);
  inp.focus(); if (!opts.multi) inp.select();
  let closed = false;
  const finish = async (save) => {
    if (closed) return; closed = true;
    const v = inp.value.trim();
    const spara = save && v !== before.trim() && (v || opts.allowEmpty);
    // Fältet MÅSTE bort innan sparningen. Annars ser spärren "rita inte om medan någon
    // skriver" sitt eget fält och hoppar över ompaintningen — värdet sparades men syntes
    // aldrig. Samma fälla som prisrutorna i pappens fest-modul.
    el.innerHTML = prevHtml;
    if (spara) await onSave(v);
  };
  inp.onclick = (e) => e.stopPropagation();
  inp.ondblclick = (e) => e.stopPropagation();
  inp.onkeydown = (e) => {
    if (e.key === "Escape") { e.stopPropagation(); return finish(false); }
    if (e.key !== "Enter") return;
    if (opts.multi && !e.metaKey && !e.ctrlKey) return;   // radbrytning i prosa
    e.preventDefault(); finish(true);
  };
  inp.onblur = () => finish(true);
}
// Fält som saknar konkurrerande klick-åtgärd öppnar redigering på ETT klick (se CSS-noten).
function bindEdit(attr, get, save, opts) {
  document.querySelectorAll("[" + attr + "]").forEach((el) => {
    el.onclick = (e) => {
      e.preventDefault(); e.stopPropagation();
      const id = el.getAttribute(attr), v = get(id);
      if (v === undefined || v === null) return;
      editable(el, v, (t) => save(id, t), opts);
    };
  });
}
const byId = (arr, id) => (S.ev[arr] || []).find((x) => x.id === id);

let toastT = null;
function showToast(txt, undo) {
  $("toast-txt").textContent = txt; S.undo = undo;
  $("toast-undo").style.display = undo ? "" : "none";   // en Ångra som inte ångrar något ljuger
  $("toast").style.display = "flex";
  clearTimeout(toastT); toastT = setTimeout(() => { $("toast").style.display = "none"; }, 5000);
}
$("toast-undo").onclick = () => { $("toast").style.display = "none"; if (S.undo) S.undo(); S.undo = null; };

// ── "+"-menyn per lista ───────────────────────────────────────────────────────
// Samlar det som förut var utspritt: en ny rad, en ny rubrik, en ny tagg, och massinmatningen.
// Prompt i stället för egna formulär — ett fält per val hade fyllt listan med tomma rutor man
// nästan aldrig använder, och prompten är samma mönster som "+" i en rubrik redan använder.
const listaNamn = (l) => (l === "shop" ? "inköpslistan" : "checklistan");
function stangMeny() { const m = $("meny"); if (m) m.remove(); }
// Delad popup: används av "+" per lista OCH av ⋯ per rad. `nyckel` gör att ett andra tryck på
// SAMMA knapp stänger menyn i stället för att rita om den.
function visaMeny(btn, nyckel, val, valj) {
  const redanOppen = $("meny") && $("meny").dataset.for === nyckel;
  stangMeny();
  if (redanOppen) return;
  const m = document.createElement("div");
  m.id = "meny"; m.dataset.for = nyckel;
  m.innerHTML = val.filter((x) => x !== undefined).map((x) =>
    x ? `<button data-mi="${x[0]}"><span class="mi">${x[1]}</span>${esc(x[2])}</button>` : "<hr>").join("");
  document.body.appendChild(m);
  // Placeras under knappen men hålls innanför fönstret — på en telefon ligger knappen ofta så
  // nära högerkanten att en meny med fast vänsterkant hade hamnat utanför.
  const r = btn.getBoundingClientRect(), b = m.getBoundingClientRect();
  m.style.top = Math.max(8, Math.min(window.innerHeight - b.height - 8, r.bottom + 6)) + "px";
  m.style.left = Math.max(8, Math.min(window.innerWidth - b.width - 8, r.right - b.width)) + "px";
  m.querySelectorAll("[data-mi]").forEach((b2) => b2.onclick = async (e) => {
    e.stopPropagation(); stangMeny();
    await valj(b2.dataset.mi);
  });
}
function oppnaPlus(btn, lista) {
  visaMeny(btn, "plus:" + lista, [
    ["rad", "➕", "Ny rad"],
    ["rubrik", "🗂", "Ny rad under en ny rubrik"],
    ["tagg", "🏷", "Ny rad med en ny tagg"],
    lista === "plan" ? ["bada", "🛒", "Ny rad — även på inköpslistan"] : null,
    null,
    ["massa", "📋", "Klistra in flera rader…"],
  ], (vad) => plusVal(vad, lista));
}

// ── ⋯ på en rad ───────────────────────────────────────────────────────────────
// Fem kontroller per rad blev en. Menyn SÄGER vad som redan är satt ("Rubrik: Kyl") i stället
// för att visa det som en ruta på raden — samma information, men bara när man frågar efter den.
function oppnaRadMeny(btn, lista, id) {
  const rad = radAv(lista, id);
  if (!rad) return;
  const namn = rad.text || rad.item || "raden";
  visaMeny(btn, "rad:" + lista + ":" + id, [
    ["rubrik", "🗂", rad.group ? `Rubrik: ${rad.group}` : "Lägg under en rubrik"],
    ["tagg", "🏷", rad.tag ? `Tagg: ${rad.tag}` : "Sätt en tagg"],
    lista === "plan" ? ["toshop", "🛒", "Lägg på inköpslistan"] : null,
    null,
    ["andra", "✎", "Ändra texten"],
    ["bort", "✕", "Ta bort raden"],
  ], async (vad) => {
    if (vad === "rubrik") {
      const v = prompt(`Rubrik för ”${namn}” (tomt tar bort rubriken):`, rad.group || "");
      if (v === null) return;
      return write("grp", { lista, id, group: v.trim() });
    }
    if (vad === "tagg") {
      const v = prompt(`Tagg för ”${namn}” — t.ex. en rätt eller ”Dryck” (tomt tar bort):`, rad.tag || "");
      if (v === null) return;
      return write("ptag", { lista, id, tag: v.trim() });
    }
    if (vad === "toshop") return laggPaInkop(id);
    if (vad === "andra") {
      const v = prompt("Ändra texten:", namn);
      if (v === null) return;
      const t = v.trim();
      if (!t || t === namn) return;
      return write(lista === "shop" ? "shopedit" : "edit", lista === "shop" ? { id, item: t } : { id, text: t });
    }
    if (vad === "bort") {
      if (!confirm(`Ta bort ”${namn}”?\n\nRaden försvinner för alla.`)) return;
      return write(lista === "shop" ? "shopdel" : "del", { id });
    }
  });
}
// 🛒 DUPLICERAR raden till inköpslistan — den flyttas inte: "Köp is" kan behöva stå kvar som
// en punkt att bocka av även när varan ligger på listan.
async function laggPaInkop(id) {
  const it = plan().find((x) => x.id === id);
  if (!it) return;
  try {
    const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&kind=toshop`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ pw: S.pw, name: S.me, id }),
    });
    S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
    draw(); showToast(`”${it.text}” ligger nu också på inköpslistan`);
  } catch (err) {
    showToast(err.message === "finns_redan" ? "Den varan finns redan på inköpslistan" : (FEL[err.message] || "Kunde inte lägga till: " + err.message));
  }
}
async function plusVal(vad, lista) {
  const skriv = (extra) => lista === "shop"
    ? write("shopadd", Object.assign({ item: extra.text }, extra.mer))
    : write("add", Object.assign({ text: extra.text, category: S.cat }, extra.mer));
  if (vad === "massa") return oppnaMassa(lista);
  if (vad === "rad") {
    const el = $(lista === "shop" ? "sItem" : "addTxt");
    if (el) { el.focus(); el.scrollIntoView({ block: "center", behavior: "smooth" }); }
    return;
  }
  if (vad === "bada") {
    const t = (prompt("Ny rad — läggs både i checklistan och på inköpslistan:", "") || "").trim();
    if (!t) return;
    // EN skrivning för båda listorna: KV-skrivningar är den trånga resursen, och två anrop
    // hade dessutom kunnat lyckas till hälften.
    return write("add", { text: t, category: S.cat, tag: S.tag || "", toshop: true });
  }
  if (vad === "rubrik") {
    const namn = (prompt(`Rubrikens namn (samlar rader i ${listaNamn(lista)}):`, "") || "").trim();
    if (!namn) return;
    const t = (prompt(`Första raden under ”${namn}”:`, "") || "").trim();
    if (!t) return;
    return skriv({ text: t, mer: { group: namn, tag: S.tag || "" } });
  }
  if (vad === "tagg") {
    const tagg = (prompt("Taggens namn (t.ex. en rätt eller ”Dryck”):", "") || "").trim();
    if (!tagg) return;
    const t = (prompt(`Första raden med taggen ”${tagg}”:`, "") || "").trim();
    if (!t) return;
    return skriv({ text: t, mer: { tag: tagg } });
  }
}
// Stäng menyn på klick utanför, Esc och scroll — den är fast positionerad och hade annars
// blivit hängande fritt när sidan rullar.
document.addEventListener("click", (e) => { if (!e.target.closest("#meny,[data-plus],[data-radmeny]")) stangMeny(); });
document.addEventListener("keydown", (e) => { if (e.key === "Escape") { stangMeny(); stangMassa(); } });
window.addEventListener("scroll", stangMeny, { passive: true });

// ── Massinmatning ─────────────────────────────────────────────────────────────
// Verktyget underhåller en plan bra men var trögt att mata EN rad i taget — den här festens
// 91 rader lades in via API:t, inte för hand. En rad som slutar med kolon blir en rubrik för
// raderna under, alltså precis så man redan skriver en lista i en anteckning.
function stangMassa() { const m = $("massa"); if (m) m.remove(); }
function oppnaMassa(lista) {
  stangMassa();
  const el = document.createElement("div");
  el.id = "massa";
  el.innerHTML = `<div class="ark">
    <h3>Klistra in flera rader</h3>
    <div style="font-size:12.5px;color:var(--dim);line-height:1.5">En rad per sak, rakt in i ${esc(listaNamn(lista))}.
      En rad som slutar med kolon blir en <b>rubrik</b> för raderna under.${lista === "shop"
      ? " Skriv gärna mängden först — ”3 dl grädde” delas upp i antal och vara av sig själv." : ""}</div>
    <textarea id="massaTxt" placeholder="${lista === "shop"
      ? "Systembolaget:&#10;8 fl mousserande&#10;5 fl rött vin&#10;&#10;Kyl:&#10;2 l grädde"
      : "Fredag:&#10;Hämta bord&#10;Duka&#10;&#10;Lördag:&#10;Hämta tårtan"}"></textarea>
    <div class="rad"><button class="btn" id="massaAvbryt">Avbryt</button>
      <button class="btn primary" id="massaGo">Lägg till</button></div>
    <div id="massaFel" style="font-size:12px;color:var(--late-ink)"></div>
  </div>`;
  document.body.appendChild(el);
  el.onclick = (e) => { if (e.target === el) stangMassa(); };   // klick utanför arket stänger
  $("massaTxt").focus();
  $("massaAvbryt").onclick = stangMassa;
  $("massaGo").onclick = async () => {
    const text = $("massaTxt").value || "";
    if (!text.trim()) return stangMassa();
    $("massaGo").disabled = true; $("massaGo").textContent = "Lägger till…";
    try {
      const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&kind=bulk`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pw: S.pw, name: S.me, lista, text, category: S.cat, tag: S.tag || "" }),
      });
      S.ev = d.event; S.log = d.changelog || []; S.sedd = d.event.updatedAt || 0;
      stangMassa();
      S.vy = lista === "shop" ? "shop" : "check"; S.open.lista = true;
      draw();
      showToast(S.log.length ? S.log[S.log.length - 1].text : "Raderna är tillagda");
    } catch (e2) {
      $("massaGo").disabled = false; $("massaGo").textContent = "Lägg till";
      $("massaFel").textContent = FEL[e2.message] || ("Kunde inte spara: " + e2.message);
    }
  };
}

// Nyckeln är "lista:id". Delas på FÖRSTA kolonet — ett rubriknamn får gärna innehålla ett.
// Modulnivå: både drag-motorn (utanför wire) och wire() läser den.
const delaNyckel = (v) => { const i = String(v).indexOf(":"); return [v.slice(0, i), v.slice(i + 1)]; };

// ── Drag and drop ─────────────────────────────────────────────────────────────
// Handtaget ÄR ⇅/+-rutan som redan flyttar raden mellan rubriker: ett klick öppnar rubriken,
// ett drag flyttar raden. Ett andra handtag hade gett två ikoner för samma sak på varje rad.
// Egen pekar-implementation, inte HTML5-draggable: HTML5 drag existerar inte på touch, och
// halva poängen är att kunna sortera listan med tummen i soffan.
let drag = null, nyssDrog = false;
const radAv = (lista, id) => byId(lista === "shop" ? "shop" : "plan", id);
const radNamn = (r) => (r && (r.text || r.item)) || "raden";
function rensaSlapp() {
  document.querySelectorAll(".slapp").forEach((x) => x.remove());
  document.querySelectorAll(".slapp-i").forEach((x) => x.classList.remove("slapp-i"));
}
function malUnder(x, y) {
  const under = document.elementFromPoint(x, y);
  if (!under) return null;
  // Sektionsdrag: bara andra RUBRIKER är släppmål. En sektion kan inte landa mitt i en annan
  // sektion — den har med sig alla sina rader, och "mitt i" vore därför inte en plats.
  if (drag.typ === "grupp") {
    const rubrik = under.closest(".grp-h[data-grph]");
    if (!rubrik) return null;
    const [lista, namn] = delaNyckel(rubrik.dataset.grph);
    if (lista !== drag.lista || namn === drag.grupp) return null;
    const r = rubrik.getBoundingClientRect();
    return { typ: "grupp", el: rubrik, grupp: namn, efter: y > r.top + r.height / 2 };
  }
  const rad = under.closest(drag.lista === "shop" ? ".s-row[data-sid]" : ".row[data-id]");
  if (rad) {
    const id = rad.dataset.sid || rad.dataset.id;
    if (id === drag.id) return null;
    const r = rad.getBoundingClientRect();
    return { typ: "rad", el: rad, id, efter: y > r.top + r.height / 2 };
  }
  const rubrik = under.closest(".grp-h");
  // Programmets dagrubriker är också .grp-h men saknar data-grpname — de är inga släppmål.
  const namnEl = rubrik && rubrik.querySelector("[data-grpname]");
  if (!namnEl) return null;
  const i = String(namnEl.dataset.grpname).indexOf(":");
  if (String(namnEl.dataset.grpname).slice(0, i) !== drag.lista) return null;
  return { typ: "rubrik", el: rubrik, grupp: String(namnEl.dataset.grpname).slice(i + 1) };
}
function visaSlapp(x, y) {
  rensaSlapp();
  const mal = malUnder(x, y);
  drag.mal = mal;
  if (!mal) return;
  if (mal.typ === "rubrik") return mal.el.classList.add("slapp-i");
  if (mal.typ === "grupp") {
    const linje = document.createElement("div");
    linje.className = "slapp slapp-grp";
    mal.el.parentNode.insertBefore(linje, mal.efter ? mal.el.nextSibling : mal.el);
    return;
  }
  const linje = document.createElement("div");
  linje.className = "slapp";
  mal.el.parentNode.insertBefore(linje, mal.efter ? mal.el.nextSibling : mal.el);
}
document.addEventListener("pointermove", (e) => {
  if (!drag) return;
  if (!drag.aktiv) {
    if (Math.abs(e.clientX - drag.x0) + Math.abs(e.clientY - drag.y0) < 8) return;
    drag.aktiv = true;
    try { drag.h.setPointerCapture(drag.pid); } catch (err) {}
    document.body.classList.add("drar");
    if (drag.rad) drag.rad.classList.add("drar-rad");
    const g = document.createElement("div");
    g.id = "spoke";
    g.textContent = drag.typ === "grupp" ? `${drag.grupp} · ${drag.antal} rader` : radNamn(radAv(drag.lista, drag.id));
    document.body.appendChild(g); drag.spoke = g;
  }
  e.preventDefault();
  drag.spoke.style.left = (e.clientX + 14) + "px";
  drag.spoke.style.top = (e.clientY - 16) + "px";
  visaSlapp(e.clientX, e.clientY);
}, { passive: false });
async function slappDrag() {
  const d = drag; drag = null;
  if (!d) return;
  if (d.spoke) d.spoke.remove();
  if (d.rad) d.rad.classList.remove("drar-rad");
  document.body.classList.remove("drar");
  rensaSlapp();
  if (!d.aktiv) return;                       // rörde sig aldrig: det var ett klick
  // Klicket som följer på ett pointerup skulle annars öppna rubrik-redigeringen.
  nyssDrog = true; setTimeout(() => { nyssDrog = false; }, 400);
  if (!d.mal) return;
  if (d.typ === "grupp") {
    // after = gruppen den nya sektionen ska ligga EFTER. Släpper man ovanför målrubriken är
    // det gruppen före målet i ordningen; är målet först blir after "" = lägg överst.
    const ordning = grupperaRader(listAv(d.lista)).map(([g]) => g).filter((g) => g && g !== "Övrigt");
    const i = ordning.indexOf(d.mal.grupp);
    const after = d.mal.efter ? d.mal.grupp : (i > 0 ? ordning[i - 1] : "");
    await write("movegroup", { lista: d.lista, group: d.grupp, after });
    return;
  }
  // Ordningen räknas UTAN den dragna raden — annars pekar "raden före målet" på en själv.
  // Gruppen följer med släppet: släpper man en rad under en annan rubrik menar man att den
  // ska höra dit, och allt annat hade krävt två handgrepp för det som ser ut som ett.
  const arr = listAv(d.lista).filter((x) => x.id !== d.id);
  let grupp = "", after = "";
  if (d.mal.typ === "rubrik") {
    grupp = d.mal.grupp;
    const i = arr.filter((x) => (x.group || "") === grupp);
    after = i.length ? i[i.length - 1].id : "";
  } else {
    const malRad = radAv(d.lista, d.mal.id);
    grupp = (malRad && malRad.group) || "";
    const i = arr.findIndex((x) => x.id === d.mal.id);
    after = d.mal.efter ? d.mal.id : (i > 0 ? arr[i - 1].id : "");
  }
  await write("move", { lista: d.lista, id: d.id, group: grupp, after });
}
document.addEventListener("pointerup", slappDrag);
document.addEventListener("pointercancel", slappDrag);
// Capture-fasen, så klicket stoppas innan bindEdit hinner öppna rubrik-redigeringen.
document.addEventListener("click", (e) => {
  if (!nyssDrog) return;
  nyssDrog = false; e.stopPropagation(); e.preventDefault();
}, true);

// ---- render ----
function draw() {
  const ev = S.ev, p = plan();
  const done = p.filter((x) => x.done).length;
  const pct = p.length ? Math.round(done / p.length * 100) : 0;
  const dl = daysTo(ev.info && ev.info.date);
  const cd = dl == null ? "" : dl > 1 ? `${dl} dagar kvar` : dl === 1 ? "i morgon" : dl === 0 ? "idag!" : "genomfört";
  const gj = (ev.guests || []).filter((g) => g.status === "ja").length;
  const gv = (ev.guests || []).filter((g) => g.status === "väntar").length;
  const gn = (ev.guests || []).filter((g) => g.status === "nej").length;

  const inCat = p.filter((x) => x.category === S.cat);
  const tags = [...new Set(inCat.map((x) => x.tag).filter(Boolean))];
  const shown = S.tag ? inCat.filter((x) => x.tag === S.tag) : inCat;
  const open = shown.filter((x) => !x.done), closed = shown.filter((x) => x.done);

  // Hopfällbar sektion. Rubriken ÄR knappen — på en telefon blir festsidan annars en rulle
  // man scrollar förbi, och det man inte jobbar med just nu ska gå att lägga undan.
  const sekt = (nyckel, rubrik, meta, kropp) => `<section class="card sec">
    <div class="sec-head sec-tog" data-sek="${esc(nyckel)}">
      <h2>${rubrik}<span class="chev${oppen(nyckel) ? "" : " stangd"}">▾</span></h2>
      <span style="font-size:12px;color:var(--dim)" class="num">${meta}</span></div>
    ${oppen(nyckel) ? kropp : ""}</section>`;

  const rowHtml = (it) => { const d = dueLabel(it.due); return `<div class="row${it.done ? " done" : ""}" data-id="${esc(it.id)}">
      <div class="box">✓</div><div class="row-txt"><div class="t" data-t="${esc(it.id)}" title="Dubbelklicka för att ändra texten">${esc(it.text)}</div></div>
      ${d.t ? `<div class="due num ${d.c}">${esc(d.t)}</div>` : ""}
      ${radSlut("plan", it)}</div>`; };

  // Aktivitetsfeeden. Låg förut i checklistan och visade två rader som bara gällde DEN listan;
  // nu är den sidans gemensamma puls i hjärtat — budget, gäster och meny hörs också.
  // OBS: raderna escapas HÄR och får inte escapas igen där de sätts in — en andra esc()
  // gjorde "Michael & Julia" till "Michael &amp; Julia" i klartext på sidan.
  const feedRader = S.log.slice(-14).reverse().map((e) => {
    const t = new Date(e.ts), hh = String(t.getHours()).padStart(2, "0"), mm = String(t.getMinutes()).padStart(2, "0");
    const nar = daysTo(t) === 0 ? "idag" : daysTo(t) === -1 ? "i går" : t.toLocaleDateString("sv-SE");
    return `<div class="feed-rad"><b>${esc(e.by)}</b> ${esc(e.text)} <span>· ${nar} ${hh}:${mm}</span></div>`;
  });
  const feed = `<div class="feed"><span class="lbl">Senaste ändringarna</span>
    <div class="feed-lista">${feedRader.length ? feedRader.join("") : `<div class="feed-tom">Inget har hänt än — det som ändras här dyker upp i listan.</div>`}</div></div>`;

  // Avbockat göms bakom "Klart · n" — det gjorda är inte det man ska mötas av när man
  // öppnar sidan. Samma mönster i inköpslistan.
  const klart = (rader, nyckel) => rader.length ? `<details class="klart" data-k="${nyckel}"${S.open[nyckel] ? " open" : ""}>
    <summary class="lbl">Klart · ${rader.length}</summary>${rader.join("")}</details>` : "";

  // 🛒 Inköpslistan. Artikel + antal + tagg som säger vilken rätt varan hör till. Raderna är
  // MATERIALISERADE, alltså vanliga rader man kan ändra och stryka — familjen har salt och
  // olja hemma och ska slippa handla dem bara för att ett recept nämner dem.
  const sh = shop();
  const shOpen = sh.filter((x) => !x.done && !arKokt(x)), shDone = sh.filter((x) => x.done || arKokt(x));
  const shRow = (x) => { const kokt = !x.done && arKokt(x); return `<div class="s-row${x.done ? " done" : ""}${kokt ? " kokt" : ""}" data-sid="${esc(x.id)}">
    <div class="box">${kokt ? "🍳" : "✓"}</div>
    <div class="s-item ed" data-sitem="${esc(x.id)}" title="${kokt ? "Ingår i en tillagad rätt" : "Klicka för att ändra varan"}">${esc(x.item)}${kokt ? ` <span class="s-kokt">tillagat</span>` : ""}</div>
    <div class="s-qty ed num" data-sqty="${esc(x.id)}" title="Klicka för att ändra antalet">${esc(x.qty || "–")}</div>
    ${radSlut("shop", x)}</div>`; };

  const utvalda = (ev.recipes || []).filter((r) => r.status !== "forslag").length;
  const vy = S.vy === "shop" ? "shop" : "check";
  // De två listorna byggs var för sig, så de kan visas antingen en i taget (flip) eller
  // sida vid sida i samma kort. Båda grupperas på rubrik; rader utan rubrik ligger först.
  // Taggfiltret på inköpslistan — samma mönster som checklistan, så man kan plocka allt till
  // en rätt i taget i butiken.
  const shTags = [...new Set(sh.map((x) => x.tag).filter(Boolean))].sort((a, b) => a.localeCompare(b, "sv"));
  if (S.stag && !shTags.includes(S.stag)) S.stag = null;
  const shOpenF = S.stag ? shOpen.filter((x) => x.tag === S.stag) : shOpen;
  // Tre sätt att ordna listan. "Min" är den enda som ÄGER ordningen — de två andra är linser
  // som räknas fram i stunden, och därför är rubrikerna där låsta: en dragen rad skulle annars
  // skriva "Frukt & grönt" som riktig rubrik på raden och göra lånet permanent.
  const SORT = [["min", "Min ordning", "Dina rubriker, i den ordning du dragit dem"],
    ["butik", "🛒 Butiken", "Gångordningen i en vanlig svensk matbutik"],
    ["ratt", "🍳 Per rätt", "En rubrik per rätt, i menyns ordning"]];
  const sortVal = S.sortShop === "butik" || S.sortShop === "ratt" ? S.sortShop : "min";
  const lastOrdning = sortVal !== "min";
  const sortRad = `<div class="sortrad">${SORT.map(([v, l, t]) =>
    `<button class="sortbtn${sortVal === v ? " on" : ""}" data-sortshop="${v}" title="${esc(t)}">${esc(l)}</button>`).join("")}</div>`;
  // Butiksordning: hyllorna i gångordning, okända varor sist under Övrigt. Per rätt: rätterna
  // i menyns ordning (utvalda före förslag), rader utan rätt sist.
  const grupperaShop = (rader, alla) => {
    if (sortVal === "min") return grupperaRader(rader, alla);
    if (sortVal === "butik") {
      const ord = hyllor().map((h) => `${h.i || ""} ${h.h}`.trim());
      const av = new Map();
      for (const r of rader) {
        const h = hyllaFor(r.item);
        const namn = h ? `${h.i || ""} ${h.h}`.trim() : "Övrigt";
        if (!av.has(namn)) av.set(namn, []);
        av.get(namn).push(r);
      }
      return [...ord, "Övrigt"].filter((n) => av.has(n)).map((n) => [n, av.get(n)]);
    }
    const ratter = (ev.recipes || []).slice().sort((a, b) => (a.status === "forslag" ? 1 : 0) - (b.status === "forslag" ? 1 : 0));
    const ord = ratter.map((r) => String(r.title || "").trim()).filter(Boolean);
    const av = new Map();
    for (const r of rader) {
      const namn = String(r.tag || "").trim() || "Utan rätt";
      if (!av.has(namn)) av.set(namn, []);
      av.get(namn).push(r);
    }
    const sedda = new Set();
    const ut = [];
    for (const n of ord) { if (av.has(n) && !sedda.has(n)) { sedda.add(n); ut.push([n, av.get(n)]); } }
    for (const [n, r] of av) if (!sedda.has(n)) ut.push([n, r]);   // taggar utan matchande rätt
    return ut;
  };
  const shopKropp = `
    ${taggRad("shop", shTags.map((t) => ({ tag: t, kvar: shOpen.filter((x) => x.tag === t).length })), S.stag, "stag")}
    ${sh.length > 1 ? sortRad : ""}
    ${shOpenF.length ? grupperaShop(shOpenF, sh).map(([g, rader]) =>
        (lastOrdning ? grpRubrikLast(g, rader.length) : grpRubrik("shop", g, rader.length)) + rader.map(shRow).join("")).join("")
      : `<div class="callout">${S.stag ? `Allt till ${esc(S.stag)} är hemma ✓` : sh.length ? "Allt är inhandlat ✓" : "Listan är tom — hämta in de utvalda rätterna eller skriv en vara."}</div>`}
    ${lastOrdning ? `<div class="sort-not">${sortVal === "butik"
        ? "Butiksordningen är en lins — dina egna rubriker ligger kvar under «Min ordning». Dra rader i den vyn."
        : "Rubrikerna är rätterna varan hämtades in från. Dra rader i «Min ordning»."}</div>` : ""}
    ${klart(shDone.map(shRow), "shklart")}
    <div class="s-add"><input class="s-in-item" id="sItem" placeholder="Vara, t.ex. Isbitar" />
      <input class="s-in-qty num" id="sQty" placeholder="Antal" /><button class="btn primary" id="sAdd">+</button></div>
    ${utvalda ? `<button class="btn wide" id="sFrom" style="margin-top:8px">🍳 Hämta in från ${utvalda} utvald${utvalda > 1 ? "a" : ""} rätt${utvalda > 1 ? "er" : ""}</button>` : ""}`;

  const checkKropp = `
    <div class="seg">${cats().map((c) => { const l = p.filter((x) => x.category === c && !x.done).length;
      return `<button data-cat="${esc(c)}" class="${c === S.cat ? "on" : ""}">${esc(c)} · ${l} kvar</button>`; }).join("")}</div>
    ${taggRad("plan", tags.map((t) => ({ tag: t, kvar: inCat.filter((x) => x.tag === t && !x.done).length })), S.tag, "tag")}
    ${open.length ? grupperaRader(open, p).map(([g, rader]) =>
        grpRubrik("plan", g, rader.length) + rader.map(rowHtml).join("")).join("")
      : `<div class="callout">${S.tag ? `Allt till ${esc(S.tag)} är hemma ✓` : "Allt på listan är klart ✓"}</div>`}
    ${klart(closed.map(rowHtml), "klart")}
    ${S.tag ? `<button class="btn wide" id="clearTag" style="margin-top:12px">Rensa filtret · visa alla ${inCat.length}</button>` : ""}
    <div class="add"><input id="addTxt" placeholder="Lägg till… (t.ex. Servetter)" /><button class="btn primary" id="addBtn">Lägg till</button></div>`;

  // Delad vy: bara meningsfull när det finns bredd. På en telefon blir två kolumner oläsliga,
  // så knappen göms under 900 px och flippen är vägen mellan listorna där.
  const bred = window.matchMedia("(min-width:900px)").matches;
  const delad = bred && !!S.split;
  // "+"-menyn samlar det som förut var utspritt över listan: ny rad, ny rubrik, ny tagg och
  // massinmatning. En knapp per lista — i delad vy finns två listor, alltså två knappar.
  const plusBtn = (lista) => `<button class="plusbtn" data-plus="${lista}" title="Lägg till rad, rubrik, tagg eller flera rader" aria-label="Lägg till">+</button>`;
  const kropp = delad
    ? `<div class="split">
         <div><div class="split-h"><span>Checklistan</span>${plusBtn("plan")}</div>${checkKropp}</div>
         <div><div class="split-h"><span>Inköpslistan</span>${plusBtn("shop")}</div>${shopKropp}</div>
       </div>`
    : (vy === "shop" ? shopKropp : checkKropp);

  const checklist = `<section class="card sec">
    <div class="sec-head">
      <div class="flip">
        <button data-vy="check" class="${delad || vy === "check" ? "on" : ""}">Checklistan</button>
        <span class="sep">/</span>
        <button data-vy="shop" class="${delad || vy === "shop" ? "on" : ""}">Inköpslistan${shOpen.length ? ` · ${shOpen.length}` : ""}</button>
      </div>
      <span style="font-size:12px;color:var(--dim)" class="num">${delad ? `${done} av ${p.length} · ${shOpen.length} att handla`
        : vy === "shop" ? `${shOpen.length} kvar av ${sh.length}` : S.tag ? `visar ${shown.length} av ${inCat.length}` : `${done} av ${p.length} klara`}</span>
      ${delad ? "" : plusBtn(vy === "shop" ? "shop" : "plan")}
      <button class="splitbtn${delad ? " on" : ""}" id="splitBtn" title="${delad ? "Visa en lista i taget" : "Visa båda listorna bredvid varandra"}" aria-label="Delad vy">${delad ? "▥" : "▤"}</button>
      <button class="chevbtn" data-sek="lista" aria-label="Fäll ihop">${oppen("lista") ? "▾" : "▸"}</button>
    </div>
    ${oppen("lista") ? kropp : ""}
  </section>`;

  // Programmet grupperas på DAG och sorteras på tid inom dagen. En festhelg börjar på torsdagen
  // med förberedelser, och utan dagrubriker låg "11:00 duka" före "13:00 gästerna kommer" som
  // om det vore samma dag. Dagen är ett datum, inte en fritextrubrik: den går att sortera, och
  // rubriken skrivs ut i klartext ("lördag 29 augusti") eftersom det är den man läser efter.
  // Punkter UTAN dag hör till festdagen — det är den vanliga punkten, och den ska inte kräva
  // att någon fyller i ett datum för att hamna rätt.
  const festDag = String((ev.info && ev.info.date) || "");
  const dagAv = (x) => String(x.date || "") || festDag;
  const progAlla = (ev.program || []).slice()
    .sort((a, b) => String(a.time || "").localeCompare(String(b.time || "")));
  const dagar = [...new Set(progAlla.map(dagAv))].sort();
  const flerDagar = dagar.filter(Boolean).length > 1;
  const progRad = (x, sist) => `<div class="tl"><div class="time num ed" data-pt="${esc(x.id)}" title="Klicka för att ändra tiden">${esc(x.time)}</div>
      <div class="dotcol"><div class="dot"></div>${sist ? "" : '<div class="line"></div>'}</div>
      <div class="txt"><span class="ed" data-px="${esc(x.id)}" title="Klicka för att ändra">${esc(x.text)}</span>
        <button class="mini grp${x.date ? " satt" : " tom"}" data-pdag="${esc(x.id)}" title="${x.date ? `${esc(dagKort(x.date))} — klicka för att ändra dagen` : "Klicka för att lägga punkten på en annan dag"}">${x.date ? esc(dagKort(x.date)) : "+"}</button>
        <button class="row-btn" data-pdel="${esc(x.id)}" title="Ta bort punkten" aria-label="Ta bort">✕</button></div></div>`;
  const program = sekt("program", "Programmet", `${progAlla.length} punkter`, `
    ${progAlla.length ? dagar.map((dag) => {
        const rader = progAlla.filter((x) => dagAv(x) === dag);
        // Ingen rubrik när allt ligger på samma dag — då säger den bara om vad som redan står
        // överst på sidan.
        const rubrik = (flerDagar && dag) ? `<div class="grp-h"><span class="lbl">${esc(dagRubrik(dag))}</span><span class="n num">${rader.length}</span></div>` : "";
        return rubrik + rader.map((x, i) => progRad(x, i === rader.length - 1)).join("");
      }).join("")
      : `<div style="font-size:13px;color:var(--dim)">Inget program än — lägg till första punkten.</div>`}
    <div class="add p-add"><input class="p-in-time" id="pTime" placeholder="18:00" inputmode="numeric" />
      <input class="p-in-time" id="pDate" placeholder="29/8" inputmode="numeric" title="Dag — lämna tomt för festdagen" />
      <input id="pText" placeholder="Vad händer?" /><button class="btn primary" id="pAdd">+</button></div>`);

  // Fyra gästlägen, samma som pappen. Kedjan är en livscykel: inte bjuden → bjuden, inget svar
  // → svarat. Nej går tillbaka till "ej bjuden" så en felklickad rad kan backas hela vägen.
  const households = [...new Set((ev.guests || []).map((g) => g.household))];
  const ej = (ev.guests || []).filter((g) => !GST[g.status] || g.status === "ej_bjuden").length;
  // Åldersfördelningen räknas på dem som SVARAT JA — det är den siffran man bokar mat, bord och
  // transport efter. Hela listans fördelning står i raden under, så inget försvinner.
  const jaGaster = (ev.guests || []).filter((g) => g.status === "ja");
  const aJa = raknaAlder(jaGaster), aAlla = raknaAlder(ev.guests || []);
  const guests = sekt("gaster", "Gästerna", `${aJa.vuxen} vuxna${aJa.tonaring ? ` · ${aJa.tonaring} tonåringar` : ""} · ${aJa.barn} barn`, `
    <div class="stats">
      <div class="stat"><b class="num" style="color:var(--ok-ink)">${gj}</b><span class="lbl">Ja</span></div>
      <div class="stat"><b class="num" style="color:var(--warn-ink)">${gv}</b><span class="lbl">Väntar</span></div>
      <div class="stat"><b class="num" style="color:var(--dim)">${gn}</b><span class="lbl">Nej</span></div>
    </div>
    <div class="stats alder">
      <div class="stat"><b class="num">${aJa.vuxen}</b><span class="lbl">Vuxna</span></div>
      <div class="stat"><b class="num">${aJa.tonaring}</b><span class="lbl">Tonåringar</span></div>
      <div class="stat"><b class="num">${aJa.barn}</b><span class="lbl">Barn</span></div>
    </div>
    <div style="font-size:11px;color:var(--faint);padding:6px 0 0;text-align:center">av dem som svarat ja</div>
    <div style="font-size:12px;color:var(--dim);padding:10px 0 4px" class="num">${(ev.guests || []).length} på listan (${aAlla.vuxen} vuxna${aAlla.tonaring ? `, ${aAlla.tonaring} tonåringar` : ""}, ${aAlla.barn} barn)${ej ? ` · ${ej} ej bjudna` : ""}${ev.info && ev.info.target ? ` · mål ~${ev.info.target}` : ""}</div>
    <div id="guestList">${households.slice(0, S.allG ? 999 : 2).map((h) => `<div class="lbl" style="padding-top:12px">${esc(h)}</div>${
      (ev.guests || []).filter((g) => g.household === h).map((g) => `<div class="g-row">
        <div class="g-name"><span class="ed" data-gn="${esc(g.id)}" title="Klicka för att ändra namnet">${esc(g.name)}</span>
          ${(() => { const a = alderAv(g); return `<button class="g-alder ${ALDER[a].c}" data-gb="${esc(g.id)}" title="Räknas som ${ALDER[a].l.toLowerCase()} — klicka för nästa" aria-label="Ålder: ${ALDER[a].l}">${ALDER[a].kort}</button>`; })()}</div>
        <div class="g-act"><button class="spill ${GST[g.status] ? GST[g.status].c : ""}" data-guest="${esc(g.id)}" title="Klicka för nästa läge">${esc((GST[g.status] || GST.ej_bjuden).l)}</button>
          <button class="row-btn" data-gdel="${esc(g.id)}" title="Ta bort gästen" aria-label="Ta bort">✕</button></div></div>`).join("")}`).join("")}</div>
    ${households.length > 2 ? `<button class="btn wide" id="allG" style="margin-top:12px">${S.allG ? "Visa färre" : `Visa alla ${households.length} hushåll`}</button>` : ""}
    <div class="g-add">
      <input type="text" id="gName" placeholder="Namn" />
      <input type="text" id="gHouse" placeholder="Sällskap" list="gHouses" />
      <datalist id="gHouses">${households.map((h) => `<option value="${esc(h)}">`).join("")}</datalist>
      <select id="gAlder" title="Ålder"><option value="vuxen">Vuxen</option><option value="tonaring">Tonåring</option><option value="barn">Barn</option></select>
      <button class="btn primary" id="gAdd">+ Lägg till</button>
    </div>`);

  // 🛒 Inköpslistan som en budgetpost. Den skrivs inte in — den RÄKNAS, ur samma rader familjen
  // bockar av i butiken, till schablonpriserna som följer med från pappen. Skälet att den är
  // expanderbar: en klumpsumma utan uppdelning går inte att lita på, man vill se vad som kostar.
  // "Kvar" är det som faktiskt ska handlas; avbockat är antingen köpt eller redan hemma, och
  // båda betyder att pengarna inte lämnar kontot. Totalen står kvar bredvid så inget försvinner
  // tyst. Saknas prislistan (eventet inte publicerat om än) visas ingen rad alls.
  const est = priser().length ? shopEstimat(shop()) : null;
  const estKvar = est ? est.kvar : 0;
  const bsum = (ev.budget || []).reduce((a, b) => a + (Number(b.est) || 0), 0);
  const bkonf = (ev.budget || []).filter((b) => b.status === "bokad" || b.status === "betald")
    .reduce((a, b) => a + (Number(b.est) || 0), 0);
  // Budget är hopfälld på mobil men ÖPPEN på desktop (facit 1d vs 5). Skälet står i briefen:
  // Maria möter sidan i mobilen och ska inte mötas av siffror först; på desktop är det
  // planerarnas vy och tabellen är själva poängen. 900px = samma brytpunkt som CSS-griden.
  const wide = window.matchMedia("(min-width:900px)").matches;
  if (S.open.budget === undefined) S.open.budget = wide;
  // Statuskedjan är pappens: att boka → offert väntas → bokad → betald. Ett klick tar nästa steg.
  const BSTAT = { ej_bokad: { l: "Att boka", c: "" }, offert: { l: "⏳ Offert", c: "b-off" },
    bokad: { l: "✅ Bokad", c: "b-ok" }, betald: { l: "💸 Betald", c: "b-paid" } };
  const bmeta = (k) => BSTAT[k] || BSTAT.ej_bokad;
  // Grupperad på inköpslistans egna rubriker, så uppdelningen är den man plockar efter.
  const estRader = est ? (() => {
    const grupper = grupperaRader(est.per.map((x) => x.rad));
    const prisAv = new Map(est.per.map((x) => [x.rad.id, x.pr]));
    return grupper.map(([g, rader]) => (g ? `<div class="b-dgrp">${esc(g)}</div>` : "") + rader.map((r) => {
      const pr = prisAv.get(r.id);
      return `<div class="b-drad${r.done ? " klar" : ""}"><span>${esc(r.item)}${r.qty ? ` · ${esc(r.qty)}` : ""}</span>
        <span class="kr num${pr ? "" : " ingen"}">${pr ? `≈ ${Math.round(pr.kr).toLocaleString("sv-SE")} kr` : "—"}</span></div>`;
    }).join("")).join("");
  })() : "";
  const estBlock = est ? `<details class="b-auto" data-k="bauto"${S.open.bauto ? " open" : ""}>
      <summary><span class="b-lbl">🛒 Inköpslistan<span style="color:var(--faint)"> · räknas fram</span></span>
        <span class="b-stat">${shop().filter((x) => !x.done && !arKokt(x)).length} kvar av ${shop().length}</span>
        <span class="b-est num">≈ ${estKvar.toLocaleString("sv-SE")} kr</span><span style="color:var(--faint);text-align:center">▾</span></summary>
      <div class="b-detalj">${estRader || `<div class="b-empty" style="padding:8px 0">Inköpslistan är tom.</div>`}
        <div class="b-dfot">Schablonpriser i vanlig matbutik och på Systembolaget — ett estimat, inte ett kvitto.
          Totalt ≈ ${est.tot.toLocaleString("sv-SE")} kr${est.tot !== estKvar ? ` · ${(est.tot - estKvar).toLocaleString("sv-SE")} kr redan avbockat` : ""}${
          est.utan ? ` · ${est.utan} ${est.utan === 1 ? "vara" : "varor"} utan pris (räknas inte in)` : ""}.
          Bocka av det ni redan har hemma, så försvinner det ur summan.</div></div>
    </details>` : "";
  const budget = `<details class="card foldable" data-k="budget"${S.open.budget ? " open" : ""}><summary><span style="font-weight:600">Budget</span>
      <span style="font-size:12px;color:var(--dim)" class="num">≈ ${(bsum + estKvar).toLocaleString("sv-SE")} kr · ${(ev.budget || []).length}${est ? " + 🛒" : ""} poster ▾</span></summary>
      ${(ev.budget || []).map((b) => `<div class="b-row">
        <span class="b-lbl ed" data-bl="${esc(b.id)}" title="Klicka för att ändra posten">${esc(b.label)}</span>
        <button class="b-stat ${bmeta(b.status).c}" data-bstat="${esc(b.id)}" title="Klicka för nästa steg">${bmeta(b.status).l}</button>
        <span class="b-est ed num" data-be="${esc(b.id)}" title="Klicka för att ändra beloppet">${(Number(b.est) || 0).toLocaleString("sv-SE")} kr</span>
        <button class="row-btn" data-bdel="${esc(b.id)}" title="Ta bort posten" aria-label="Ta bort">✕</button></div>`).join("")
        || `<div class="b-empty">Inga poster än.</div>`}
      ${estBlock}
      <div class="b-add"><input class="b-in-lbl" id="bLabel" placeholder="Ny post, t.ex. Tårta" />
        <input class="b-in-est num" id="bEst" inputmode="numeric" placeholder="kr" />
        <button class="btn primary" id="bAdd">+</button></div>
      <div class="b-foot num">Bokat eller betalt ≈ ${bkonf.toLocaleString("sv-SE")} kr · kvar att spika ≈ ${(bsum - bkonf + estKvar).toLocaleString("sv-SE")} kr${
        est ? ` (varav ≈ ${estKvar.toLocaleString("sv-SE")} kr inköpslista)` : ""}</div>
    </details>`;

  // Underlagen bodde förut som lösa kort med ett eget add-kort under. Nu EN sektion som fälls
  // ihop som de andra, med Lägg till överst och varje underlag hopfällbart för sig.
  const docsKropp = `<div class="add" style="margin-top:0">
      <input id="dTitle" placeholder="Nytt underlag… (t.ex. Transport)" /><button class="btn primary" id="dAdd">Lägg till</button></div>
    ${(ev.docs || []).length ? (ev.docs || []).map((d) => `<details class="dok" data-k="${esc(d.id)}"${S.open[d.id] ? " open" : ""}>
      <summary><span class="dok-t ed" data-dt="${esc(d.id)}" title="Klicka för att ändra rubriken">${esc(d.title)}</span>
      <span class="d-sum-act"><button class="row-btn" data-ddel="${esc(d.id)}" title="Ta bort underlaget" aria-label="Ta bort">✕</button>›</span></summary>
      <div class="d-body ed" data-db="${esc(d.id)}" title="Klicka för att skriva">${d.body ? esc(d.body) : `<span style="color:var(--faint)">Tomt — klicka för att skriva.</span>`}</div>
    </details>`).join("") : `<div style="font-size:13px;color:var(--dim);padding-top:12px">Inga underlag än.</div>`}`;
  const docs = sekt("underlag", "Underlag", `${(ev.docs || []).length} st`, docsKropp);

  // 🍳 Menyn: utvalda först (det som faktiskt lagas), förslagen under. Alla får föreslå och
  // stjärnmärka — sidan är planeringsgängets, precis som checklistan.
  const recs = Array.isArray(ev.recipes) ? ev.recipes : [];
  const rUt = recs.filter((r) => r.status !== "forslag");
  const rFo = recs.filter((r) => r.status === "forslag");
  // Ett klick på rätten öppnar den: ingredienser att skriva i, och utförandet att läsa.
  // Stjärnan/bilden/✕ ligger utanför klickytan så de inte krockar.
  const rRow = (r) => {
    const upp = !!S.open["r:" + r.id];
    return `<div class="r-row${r.cooked && r.status !== "forslag" ? " kokt" : ""}" data-rid="${esc(r.id)}">
    <div class="r-thumb" data-ropen="${esc(r.id)}"${r.image ? ` style="background-image:url('${esc(r.image)}')"` : ""}>${r.image ? "" : "🍽"}</div>
    <div class="r-main" data-ropen="${esc(r.id)}" title="Klicka för ingredienser och utförande">
      <div class="r-title" data-rt="${esc(r.id)}" title="Dubbelklicka för att döpa om">${esc(r.title)}${
        r.cooked && r.status !== "forslag" ? ` <span class="r-kokt">🍳 Tillagad</span>` : ""}</div>
      <div class="r-sub">${[
        (r.ingredients && r.ingredients.length)
          ? (() => { const h = new Set((r.have || []).map(haveKey));
              const klar = (r.ingredients || []).filter((x) => h.has(haveKey(x))).length;
              const kvar = r.ingredients.length - klar;
              return `<span class="ing-sum"><b>${klar} klar</b> · <i>${kvar} saknas</i></span>`; })()
          : "inga ingredienser än",
        (r.steps && r.steps.length) ? `${r.steps.length} steg` : "",
        r.by ? `av ${esc(r.by)}` : "",
        r.source ? `<a href="${esc(r.source)}" target="_blank" rel="noopener">källa ↗</a>` : "",
      ].filter(Boolean).join(" · ")}</div>
    </div>
    <div class="r-act">
      <button class="r-btn${S.rmenu === r.id ? " on" : ""}" data-rmenu="${esc(r.id)}" title="Fler val: utvald, tillagat, bild, ta bort" aria-label="Fler val">⋯</button>
      ${S.rmenu === r.id ? `<div class="r-meny" role="menu">
        <button data-rstar="${esc(r.id)}">${r.status !== "forslag" ? "☆ Flytta till förslag" : "★ Välj ut — blir mat"}</button>
        ${r.status !== "forslag" ? `<button data-rcook="${esc(r.id)}">${r.cooked ? "↩ Ångra tillagat" : "🍳 Tillagat — stryk varorna ur listan"}</button>` : ""}
        <button data-rimg="${esc(r.id)}">🖼 Lägg till bild</button>
        <div class="r-meny-sep"></div>
        <button class="fara" data-rdel="${esc(r.id)}">🗑 Ta bort rätten</button>
      </div>` : ""}
    </div>
  </div>${upp ? (() => {
    const f = skalfaktor(r);
    const har = new Set((r.have || []).map(haveKey));
    const lagar = lagarAv(r);
    return `<div class="r-detalj">
      <div class="r-serv">Receptet är skrivet för <span class="ed" data-rserv="${esc(r.id)}">${r.servings || "?"}</span> personer ·
        vi lagar <span class="ed" data-rport="${esc(r.id)}">${lagar || "?"}</span>${r.portions ? "" : " (festens tal)"}${
        r.servings && lagar ? ` → mängderna <span class="fak">×${String(Math.round(f * 100) / 100).replace(".", ",")}</span>`
        : ` — fyll i vad receptet är skrivet för så räknas mängderna om`}</div>
      <div class="ing-head"><span class="lbl">Ingredienser <span style="text-transform:none;font-weight:400">— klicka det ni har hemma</span></span>
        <button class="r-btn" data-ringbtn="${esc(r.id)}" title="Skriv om hela listan">✎</button></div>
      ${(r.ingredients || []).length
        ? (r.ingredients || []).map((rad) => { const klar = har.has(haveKey(rad)); return `<div class="ing-rad${klar ? " klar" : ""}">
            <button class="ing-st${klar ? " klar" : ""}" data-rhave="${esc(r.id)}" data-line="${esc(rad)}" title="${klar ? "Klar — klicka för att lägga tillbaka på inköpslistan" : "Ska handlas — klicka när den är klar"}">${klar ? "Klar" : "Inköpslista"}</button>
            <div class="ing-txt ed" data-ringone="${esc(r.id)}|${esc(rad)}" title="Klicka för att ändra">${esc(skalaQty(rad, f))}</div>
            <button class="row-btn" data-ringdel="${esc(r.id)}|${esc(rad)}" title="Ta bort ingrediensen" aria-label="Ta bort">✕</button>
          </div>`; }).join("")
        : `<div class="r-txt tom">Inga ingredienser än — skriv in dem en i taget nedan.</div>`}
      <div class="ing-add">
        <input class="ing-in-qty" data-ingq="${esc(r.id)}" placeholder="3 dl" />
        <input class="ing-in-item" data-ingi="${esc(r.id)}" placeholder="Vara, t.ex. grädde" />
        <button class="btn primary" data-ingadd="${esc(r.id)}" style="height:40px;padding:0 14px">+</button>
      </div>
      <div style="font-size:11px;color:var(--faint);margin-top:6px">Skriv mängden som receptet står i — appen räknar om den mot antalet personer.</div>
      <div class="r-txt ed" data-ring="${esc(r.id)}" hidden></div>
      <span class="lbl">Utförande</span>
      <div class="r-txt ed${(r.steps || []).length ? "" : " tom"}" data-rstep="${esc(r.id)}">${(r.steps || []).length ? esc((r.steps || []).map((t, i) => `${i + 1}. ${t}`).join("\n")) : "Inget utförande än — klicka och skriv, eller läs på källan."}</div>
      <button class="btn wide" data-rshop="${esc(r.id)}">🛒 Lägg varorna i inköpslistan${har.size ? ` — hoppar över ${har.size} ni har` : ""}</button>
    </div>`; })() : ""}`;
  };
  const lagarFor = Number(ev.info && ev.info.cook) || 0;
  const menyKropp = `<div class="cook-row">Vi lagar för <span class="ed num" data-cook="1" title="Klicka för att ändra">${lagarFor || "?"}</span> personer${
      lagarFor ? "" : ` <span style="color:var(--faint)">— fyll i så räknas recepten om</span>`}</div>
    ${recs.length ? `
      ${rUt.length ? `<div class="r-grp">Blir mat</div>${rUt.map(rRow).join("")}` : ""}
      ${rFo.length ? `<div class="r-grp">Förslag</div>${rFo.map(rRow).join("")}` : ""}`
      : `<div style="font-size:13px;color:var(--dim)">Inga rätter än — föreslå den första.</div>`}
    <div class="r-form">
      <input id="rNew" placeholder="Rättens namn — eller klistra in en recept-länk" />
      <button class="btn primary wide" id="rAdd">Föreslå rätt</button>
      <div style="font-size:12px;color:var(--dim)" id="rMsg">Klistrar du in en länk hämtas namn, bild, ingredienser och utförande automatiskt. Skriver du bara ett namn fyller du i resten själv genom att klicka på rätten.</div>
    </div>`;
  const meny = sekt("meny", "Menyn", `${rUt.length} utvalda${rFo.length ? ` · ${rFo.length} förslag` : ""}`, menyKropp);

  const upd = S.log.length ? new Date(S.log[S.log.length - 1].ts) : null;
  $("app").innerHTML = `
    <div class="sticky" id="sticky"><span style="font-size:14px;font-weight:650">${esc(ev.info.title)}</span><span style="font-size:12px;font-weight:600;color:var(--champ-ink)">${esc(cd)}</span></div>
    <section class="card heart"><div class="heart-in">
      <div class="heart-mitt">
      <div class="lbl">${esc(ev.info.dateLabel || ev.info.date || "")}</div>
      <h1>${esc(ev.info.title)}</h1>
      ${ev.info.subtitle ? `<div style="font-size:13px;color:var(--dim);margin-top:4px">${esc(ev.info.subtitle)}</div>` : ""}
      <div class="rule"></div>
      <div style="font-size:13px">${esc(ev.info.place || "")}</div>
      ${cd ? `<div style="margin-top:16px"><span class="pill num">${esc(cd)}</span></div>` : ""}
      <div class="track"><div class="fill" style="width:${pct}%"></div></div>
      <div style="font-size:12px;color:var(--dim)" class="num">${done} av ${p.length} på listan klara · ${gj} gäster har svarat ja</div>
      <button class="btn" id="share" style="margin-top:16px;height:38px;font-size:13px">Dela sidan</button>
      </div>${feed}
    </div></section>
    <div class="grid"><div class="gcol">${checklist}${meny}${budget}</div><div class="gcol">${program}${guests}${docs}</div></div>
    <div class="foot">Sidan delas av planeringsgänget${upd ? ` · uppdaterad ${daysTo(upd) === 0 ? "idag" : upd.toLocaleDateString("sv-SE")} ${String(upd.getHours()).padStart(2, "0")}:${String(upd.getMinutes()).padStart(2, "0")}` : ""}</div>`;
  wire();
}

function wire() {
  document.querySelectorAll("[data-cat]").forEach((b) => b.onclick = () => { S.cat = b.dataset.cat; S.tag = null; draw(); });
  // Den aktiva chipen visar ✕ — då ska ett klick SLÄPPA filtret. Förut satte den om samma
  // tagg igen, så krysset var en tom gest: enda vägen tillbaka var "Rensa filtret"-knappen
  // längst ned. Hittat när "Färdigt" gjorde det möjligt att filtrera på en avbockad tagg och
  // listan såg tom ut utan uppenbar väg ur.
  const valjTagg = (falt) => (b) => b.onclick = () => {
    const v = b.dataset[falt] || null;
    S[falt] = (v && v === S[falt]) ? null : v;
    draw();
  };
  document.querySelectorAll("[data-tag]").forEach(valjTagg("tag"));
  document.querySelectorAll("[data-stag]").forEach(valjTagg("stag"));
  // "✓ Färdigt" fäller bara ut gruppen — den filtrerar ingenting själv.
  document.querySelectorAll("[data-klart]").forEach((b) => b.onclick = () => {
    const l = b.dataset.klart; S.klartOppen[l] = !S.klartOppen[l]; draw();
  });
  // Bocken bockar av, texten döps om. Förut bockade ett klick på TEXTEN av efter en fördröjning
  // — vilket gjorde att man inte kunde läsa en lång rad utan att råka bocka av den, och att
  // varje omdöpning kändes som en kamp. Nu har de två helt skilda ytor.
  document.querySelectorAll(".row").forEach((r) => {
    r.onclick = (e) => {
      if (e.target.closest("button") || e.target.closest(".t-edit")) return;
      if (e.target.closest(".t[data-t]")) return;       // texten: dubbelklick döper om
      toggle(r.dataset.id);
    };
  });
  // Dubbelklick PÅ SJÄLVA TEXTEN öppnar redigering — inte på raden i övrigt, och ingen
  // penn-ikon att leta efter. Enter eller klick utanför sparar, Esc ångrar.
  document.querySelectorAll(".t[data-t]").forEach((el) => {
    el.ondblclick = (e) => { e.stopPropagation(); startEdit(el, el.dataset.t); };
  });
  // Inline-redigering på plats — samma hjälpare som resten av sidan använder.
  function startEdit(el, id) {
    const it = plan().find((p) => p.id === id); if (!it) return;
    editable(el, it.text, (t) => write("edit", { id, text: t }));
  }
  // Klick utanför ⋯-menyn stänger den. Sätts om vid varje draw, så det blir aldrig två.
  if (S.rmenu) document.addEventListener("mousedown", (e) => {
    if (e.target.closest && e.target.closest(".r-meny, [data-rmenu]")) return;
    if (!S.rmenu) return;
    S.rmenu = null; draw();
  }, { once: true, capture: true });
  document.querySelectorAll("[data-rdel]").forEach((b) => b.onclick = async () => {
    const r = (S.ev.recipes || []).find((x) => x.id === b.dataset.rdel); if (!r) return;
    S.rmenu = null;
    if (!confirm(`Ta bort ”${r.title}” ur menyn?\n\nRätten försvinner för alla.`)) return;
    await write("rdel", { id: b.dataset.rdel });
  });
  document.querySelectorAll("[data-guest]").forEach((b) => b.onclick = () => {
    const g = (S.ev.guests || []).find((x) => x.id === b.dataset.guest); if (!g) return;
    const next = (GST[g.status] || GST.ej_bjuden).next;
    g.status = next; draw(); write("guest", { id: b.dataset.guest, status: next }, true);
  });
  // ───────── Full paritet (2026-08-27): budget, program, gäster, underlag ─────────
  // Varje skrivning ritar om hela appen. Utan detta slog varje öppen <details> igen mitt i
  // arbetet — värst i underlagen, där man just höll på att skriva.
  document.querySelectorAll("details[data-k]").forEach((d) => {
    d.ontoggle = () => { S.open[d.dataset.k] = d.open; };
  });

  // Budget
  bindEdit("data-bl", (id) => (byId("budget", id) || {}).label, (id, v) => write("bedit", { id, label: v }));
  bindEdit("data-be", (id) => { const b = byId("budget", id); return b ? String(b.est == null ? 0 : b.est) : null; },
    // "12 000 kr" ska funka lika bra som "12000" — folk skriver som de läser.
    (id, v) => write("bedit", { id, est: v.replace(/[^0-9]/g, "") || 0 }));
  document.querySelectorAll("[data-bstat]").forEach((btn) => btn.onclick = () => {
    const b = byId("budget", btn.dataset.bstat); if (!b) return;
    const kedja = ["ej_bokad", "offert", "bokad", "betald"];
    b.status = kedja[(kedja.indexOf(b.status) + 1) % kedja.length]; draw();   // optimistiskt
    write("bstat", { id: btn.dataset.bstat }, true);
  });
  document.querySelectorAll("[data-bdel]").forEach((btn) => btn.onclick = async () => {
    const b = byId("budget", btn.dataset.bdel); if (!b) return;
    if (!confirm(`Ta bort budgetposten ”${b.label}”?\n\nPosten försvinner för alla.`)) return;
    await write("bdel", { id: btn.dataset.bdel });
  });
  const addB = () => {
    const label = ($("bLabel").value || "").trim(); if (!label) return;
    const est = ($("bEst").value || "").replace(/[^0-9]/g, "");
    write("badd", { label, est: est || 0 });
  };
  const bA = $("bAdd"); if (bA) bA.onclick = addB;
  ["bLabel", "bEst"].forEach((id) => { const el = $(id); if (el) el.onkeydown = (e) => { if (e.key === "Enter") addB(); }; });

  // Program
  bindEdit("data-px", (id) => (byId("program", id) || {}).text, (id, v) => write("pedit", { id, text: v }));
  bindEdit("data-pt", (id) => (byId("program", id) || {}).time, (id, v) => write("pedit", { id, time: v }));
  // Dagen. Tomt fält = festdagen, alltså vägen tillbaka från ett eget datum.
  bindEdit("data-pdag", (id) => { const x = byId("program", id); return x ? (x.date || "") : null; },
    (id, v) => write("pedit", { id, date: v }), { allowEmpty: true });
  document.querySelectorAll("[data-pdel]").forEach((btn) => btn.onclick = async () => {
    const x = byId("program", btn.dataset.pdel); if (!x) return;
    if (!confirm(`Ta bort ”${x.text}” ur programmet?\n\nPunkten försvinner för alla.`)) return;
    await write("pdel", { id: btn.dataset.pdel });
  });
  const addP = () => {
    const text = ($("pText").value || "").trim(); if (!text) return;
    write("padd", { text, time: ($("pTime").value || "").trim(), date: ($("pDate").value || "").trim() });
  };
  const pA = $("pAdd"); if (pA) pA.onclick = addP;
  ["pTime", "pDate", "pText"].forEach((id) => { const el = $(id); if (el) el.onkeydown = (e) => { if (e.key === "Enter") addP(); }; });

  // Gäster
  // guestName, inte name — write() fyller name med VEM som ändrar (se Workern).
  bindEdit("data-gn", (id) => (byId("guests", id) || {}).name, (id, v) => write("gedit", { id, guestName: v }));
  // Åldern cyklar vuxen → tonåring → barn → vuxen, samma mönster som gäststatusen bredvid.
  document.querySelectorAll("[data-gb]").forEach((btn) => btn.onclick = () => {
    const g = byId("guests", btn.dataset.gb); if (!g) return;
    const next = ALDER[alderAv(g)].next;
    g.alder = next; g.barn = next === "barn"; draw();                          // optimistiskt
    write("gedit", { id: btn.dataset.gb, alder: next }, true);
  });
  document.querySelectorAll("[data-gdel]").forEach((btn) => btn.onclick = async () => {
    const g = byId("guests", btn.dataset.gdel); if (!g) return;
    if (!confirm(`Ta bort ${g.name} ur gästlistan?\n\nGästen försvinner för alla.`)) return;
    await write("gdel", { id: btn.dataset.gdel });
  });
  const addG = () => {
    const name = ($("gName").value || "").trim(); if (!name) return;
    write("gadd", { guestName: name, household: ($("gHouse").value || "").trim(), alder: ($("gAlder") || {}).value || "vuxen" });
  };
  const gA = $("gAdd"); if (gA) gA.onclick = addG;
  ["gName", "gHouse"].forEach((id) => { const el = $(id); if (el) el.onkeydown = (e) => { if (e.key === "Enter") addG(); }; });

  // Underlag. Textkroppen är prosa: flerradigt fält, Enter ger radbrytning, ⌘/Ctrl+Enter sparar.
  // Tom kropp är ett giltigt värde — man ska kunna tömma ett underlag utan att radera det.
  bindEdit("data-dt", (id) => (byId("docs", id) || {}).title, (id, v) => write("dedit", { id, title: v }));
  bindEdit("data-db", (id) => { const d = byId("docs", id); return d ? (d.body || "") : null; },
    (id, v) => write("dedit", { id, body: v }), { multi: true, allowEmpty: true });
  document.querySelectorAll("[data-ddel]").forEach((btn) => btn.onclick = async (e) => {
    e.preventDefault(); e.stopPropagation();                 // ligger i <summary> — får inte fälla ut kortet
    const d = byId("docs", btn.dataset.ddel); if (!d) return;
    if (!confirm(`Ta bort underlaget ”${d.title}”?\n\nAll text i det försvinner för alla.`)) return;
    await write("ddel", { id: btn.dataset.ddel });
  });
  const addD = () => { const t = ($("dTitle").value || "").trim(); if (!t) return; write("dadd", { title: t }); };
  const dA = $("dAdd"); if (dA) dA.onclick = addD;
  const dT = $("dTitle"); if (dT) dT.onkeydown = (e) => { if (e.key === "Enter") addD(); };

  // ── Hopfällbara sektioner + "Klart · n" ──
  document.querySelectorAll("[data-sek]").forEach((el) => el.onclick = (e) => {
    if (e.target.closest("button[data-vy]")) return;         // flippen är inte en fäll-knapp
    const k = el.dataset.sek; S.open[k] = !oppen(k); draw();
  });


  // ── Checklistan ⇄ Inköpslistan ──
  document.querySelectorAll("[data-vy]").forEach((b) => b.onclick = (e) => {
    e.stopPropagation(); S.vy = b.dataset.vy; S.split = false; S.open.lista = true; draw();
  });

  // ── Inköpslistan ──
  document.querySelectorAll(".s-row").forEach((r) => r.onclick = (e) => {
    if (e.target.closest("button") || e.target.closest(".ed") || e.target.closest(".t-edit")) return;
    const x = byId("shop", r.dataset.sid); if (!x) return;
    x.done = !x.done; draw();                                 // optimistiskt, känns direkt i butiken
    write("shoptoggle", { id: r.dataset.sid }, true);
  });
  bindEdit("data-sitem", (id) => (byId("shop", id) || {}).item, (id, v) => write("shopedit", { id, item: v }));
  // Antalet får vara tomt — "ost" utan mängd är en fullt rimlig rad på en inköpslista.
  bindEdit("data-sqty", (id) => { const x = byId("shop", id); return x ? (x.qty || "") : null; },
    (id, v) => write("shopedit", { id, qty: v }), { allowEmpty: true });
  const addS = () => {
    const item = ($("sItem").value || "").trim(); if (!item) return;
    write("shopadd", { item, qty: ($("sQty").value || "").trim() });
  };
  const sA = $("sAdd"); if (sA) sA.onclick = addS;
  ["sItem", "sQty"].forEach((id) => { const el = $(id); if (el) el.onkeydown = (e) => { if (e.key === "Enter") addS(); }; });
  document.querySelectorAll("[data-sortshop]").forEach((b) => b.onclick = () => {
    S.sortShop = b.dataset.sortshop;
    try { localStorage.setItem("fest:sortshop", S.sortShop); } catch (e) {}
    draw();                                   // ren vy-växling, ingen skrivning till molnet
  });
  const sF = $("sFrom"); if (sF) sF.onclick = () => write("shopfrom", {});

  // ── Rätten: öppna, skriv ingredienser, läs utförande ──
  // Ett klick öppnar rätten, ett dubbelklick på TITELN döper om den. Öppningen fördröjs därför
  // när klicket sker på titeln, och ställs in om ett dubbelklick hinner först — annars hade
  // varje omdöpning börjat med att rätten hoppade upp och ner.
  let rClickT = null;
  document.querySelectorAll("[data-ropen]").forEach((el) => el.onclick = (e) => {
    if (e.target.closest("a") || e.target.closest(".t-edit")) return;   // källänken öppnar källan
    const k = "r:" + el.dataset.ropen;
    const oppna = () => { S.open[k] = !S.open[k]; draw(); };
    if (e.target.closest(".r-title")) { clearTimeout(rClickT); rClickT = setTimeout(oppna, 260); }
    else oppna();
  });
  document.querySelectorAll("[data-rt]").forEach((el) => {
    el.ondblclick = (e) => {
      e.stopPropagation(); clearTimeout(rClickT);
      const r = byId("recipes", el.dataset.rt); if (!r) return;
      editable(el, r.title, (t) => write("rtitle", { id: el.dataset.rt, title: t }));
    };
  });
  // Hur många vi lagar av just den här rätten. Tomt fält = följ festens tal igen.
  bindEdit("data-rport", (id) => { const r = byId("recipes", id); return r ? String(r.portions || "") : null; },
    (id, v) => write("rport", { id, n: v.replace(/[^0-9]/g, "") || 0 }), { allowEmpty: true });
  // ✎ öppnar hela ingredienslistan som text. Fältet ligger dolt tills man trycker — annars
  // hade varje rad varit både en "har hemma"-knapp och ett textfält, och de två krockar.
  // EN ingrediens i taget. Redigeraren öppnar med receptets EGNA mängd, inte den omräknade
  // som visas — annars hade en rättad stavning sparat "7,5 dl" som receptets grundmängd och
  // skalat den en gång till nästa gång.
  const delaIng = (v) => { const i = String(v).indexOf("|"); return [v.slice(0, i), v.slice(i + 1)]; };
  bindEdit("data-ringone", (k) => delaIng(k)[1],
    (k, v) => { const [id, from] = delaIng(k); return write("ringedit", { id, from, qty: "", item: v }); });
  document.querySelectorAll("[data-ringdel]").forEach((b) => b.onclick = async (e) => {
    e.stopPropagation();
    const [id, line] = delaIng(b.dataset.ringdel);
    if (!confirm(`Ta bort ”${line}” ur receptet?`)) return;
    await write("ringdel", { id, line });
  });
  document.querySelectorAll("[data-ingadd]").forEach((b) => {
    const id = b.dataset.ingadd;
    const q = document.querySelector(`[data-ingq="${id}"]`), it = document.querySelector(`[data-ingi="${id}"]`);
    const lagg = () => { const vara = (it.value || "").trim(); if (!vara) return;
      write("ringadd", { id, qty: (q.value || "").trim(), item: vara }); };
    b.onclick = lagg;
    [q, it].forEach((el) => el && (el.onkeydown = (e) => { if (e.key === "Enter") lagg(); }));
  });
  bindEdit("data-ring", (id) => ((byId("recipes", id) || {}).ingredients || []).join("\n"),
    (id, v) => write("ringred", { id, text: v }), { multi: true, allowEmpty: true });
  document.querySelectorAll("[data-ringbtn]").forEach((b) => b.onclick = () => {
    const el = document.querySelector(`[data-ring="${b.dataset.ringbtn}"]`); if (!el) return;
    el.hidden = false; el.click();
  });
  // Grönt = har hemma. Hoppas över när listan hämtas in, och plockas bort ur listan direkt
  // om varan redan låg där.
  document.querySelectorAll("[data-rhave]").forEach((b) => b.onclick = () => {
    const r = byId("recipes", b.dataset.rhave); if (!r) return;
    r.have = Array.isArray(r.have) ? r.have : [];
    const k = haveKey(b.dataset.line);
    const i = r.have.findIndex((x) => haveKey(x) === k);
    if (i === -1) r.have.push(b.dataset.line); else r.have.splice(i, 1);
    draw();                                                   // optimistiskt
    write("rhave", { id: b.dataset.rhave, line: b.dataset.line }, true);
  });
  // Antalet personer: ett tal för hela festen, och receptets eget.
  bindEdit("data-cook", () => String(Number(S.ev.info && S.ev.info.cook) || ""),
    (_id, v) => write("cook", { n: v.replace(/[^0-9]/g, "") || 0 }), { allowEmpty: true });
  bindEdit("data-rserv", (id) => { const r = byId("recipes", id); return r ? String(r.servings || "") : null; },
    (id, v) => write("rserv", { id, n: v.replace(/[^0-9]/g, "") || 0 }), { allowEmpty: true });
  // Stegen visas numrerade men lagras utan nummer — annars hade en omskrivning gett "1. 1. …".
  bindEdit("data-rstep", (id) => ((byId("recipes", id) || {}).steps || []).join("\n"),
    (id, v) => write("rsteps", { id, text: v }), { multi: true, allowEmpty: true });
  document.querySelectorAll("[data-rshop]").forEach((b) => b.onclick = async () => {
    await write("shopfrom", { id: b.dataset.rshop });
    S.vy = "shop"; S.open.lista = true; draw();
  });

  // ── Rubriker och taggar ──
  // Rubriken är inget eget objekt — den ÄR fältet på raderna. Att döpa om den skriver därför
  // om alla rader som bär den, och ett tomt namn löser upp gruppen.
  document.querySelectorAll("[data-grpname]").forEach((el) => {
    el.ondblclick = (e) => {
      e.stopPropagation();
      const [lista, namn] = delaNyckel(el.dataset.grpname);
      editable(el, namn, (t) => write("grpname", { lista, from: namn, to: t }), { allowEmpty: true });
    };
  });
  // "+" i en rubrik: lägg raden direkt i gruppen. Prompt i stället för ett inline-fält —
  // ett fält per rubrik hade fyllt listan med tomma rutor man aldrig använder.
  document.querySelectorAll("[data-grpadd]").forEach((b) => b.onclick = async (e) => {
    e.stopPropagation();
    const [lista, grupp] = delaNyckel(b.dataset.grpadd);
    const v = prompt(lista === "shop" ? `Ny vara under ”${grupp}”:` : `Ny rad under ”${grupp}”:`, "");
    if (v === null) return;
    const t = v.trim(); if (!t) return;
    if (lista === "shop") await write("shopadd", { item: t, group: grupp });
    else await write("add", { text: t, category: S.cat, group: grupp, tag: S.tag || "" });
  });
  // Drag and drop: bara pointerdown binds här, resten av lyssnarna sitter på document och
  // registreras EN gång (wire() körs vid varje omritning och hade annars staplat dem).
  // ⋯ är både meny och draghandtag: ett tryck öppnar menyn, ett drag flyttar raden. Samma
  // dubbelroll som ⇅-rutan hade — nyssDrog hindrar att släppet också öppnar menyn.
  document.querySelectorAll("[data-radmeny]").forEach((h) => {
    const [lista, id] = delaNyckel(h.dataset.radmeny);
    h.onpointerdown = (e) => {
      if (e.button != null && e.button !== 0) return;
      // I butiks-/rätt-vyn ÄGER listan inte sin ordning — ett drag där skulle skriva en lånad
      // rubrik på raden. Menyn (klicket) funkar fortfarande.
      if (lista === "shop" && S.sortShop !== "min") return;
      drag = { h, lista, id, x0: e.clientX, y0: e.clientY, pid: e.pointerId,
        aktiv: false, mal: null, rad: h.closest(".row,.s-row") };
    };
    h.onclick = (e) => { e.preventDefault(); e.stopPropagation(); oppnaRadMeny(h, lista, id); };
  });
  // Sektionsdrag: samma motor, eget handtag (⠿) i rubriken. Rubriken bär inga rader själv —
  // draget flyttar gruppen, och workern numrerar om raderna så de följer med.
  document.querySelectorAll("[data-grpdrag]").forEach((h) => {
    const [lista, grupp] = delaNyckel(h.dataset.grpdrag);
    h.onpointerdown = (e) => {
      if (e.button != null && e.button !== 0) return;
      if (lista === "shop" && S.sortShop !== "min") return;   // härledd ordning ägs inte av listan
      const antal = listAv(lista).filter((x) => (x.group || "") === grupp).length;
      drag = { typ: "grupp", h, lista, grupp, antal, x0: e.clientX, y0: e.clientY, pid: e.pointerId,
        aktiv: false, mal: null, rad: h.closest(".grp-h") };
    };
  });
  // Toning bara när det faktiskt finns mer att se — i feeden nedåt, i taggraden åt höger.
  const feedEl = document.querySelector(".feed-lista");
  if (feedEl) feedEl.classList.toggle("mer", feedEl.scrollHeight > feedEl.clientHeight + 2);
  document.querySelectorAll(".chips").forEach((c) => {
    const uppdatera = () => c.classList.toggle("mer", c.scrollWidth > c.clientWidth + c.scrollLeft + 2);
    uppdatera();
    c.onscroll = uppdatera;              // toningen försvinner när man scrollat hela vägen ut
  });

  document.querySelectorAll("[data-plus]").forEach((b) => b.onclick = (e) => {
    e.preventDefault(); e.stopPropagation();
    oppnaPlus(b, b.dataset.plus);
  });

  // Delad vy. Klickar man på en av rubrikerna i delat läge menar man "visa bara den".
  const sb = $("splitBtn"); if (sb) sb.onclick = (e) => { e.stopPropagation(); S.split = !S.split; S.open.lista = true; draw(); };

  const cl = $("clearTag"); if (cl) cl.onclick = () => { S.tag = null; draw(); };
  const ag = $("allG"); if (ag) ag.onclick = () => { S.allG = !S.allG; draw(); };
  const add = () => { const t = $("addTxt").value.trim(); if (!t) return; $("addTxt").value = ""; write("add", { text: t, category: S.cat, tag: S.tag || "" }); };
  const ab = $("addBtn"); if (ab) ab.onclick = add;
  const at = $("addTxt"); if (at) at.addEventListener("keydown", (e) => { if (e.key === "Enter") add(); });
  // 🍳 Meny-wiring. ⋯ öppnar valen; allt annat i menyn stänger den innan det körs.
  document.querySelectorAll("[data-rmenu]").forEach((b) => b.onclick = (e) => {
    e.stopPropagation();
    S.rmenu = S.rmenu === b.dataset.rmenu ? null : b.dataset.rmenu;
    draw();
  });
  document.querySelectorAll("[data-rstar]").forEach((b) => b.onclick = () => {
    const r = (S.ev.recipes || []).find((x) => x.id === b.dataset.rstar); if (!r) return;
    S.rmenu = null;
    r.status = r.status === "forslag" ? "utvald" : "forslag";
    if (r.status === "forslag") r.cooked = false;   // ett förslag lagas inte
    draw();   // optimistiskt
    write("rstar", { id: b.dataset.rstar }, true);
  });
  document.querySelectorAll("[data-rcook]").forEach((b) => b.onclick = () => {
    const r = (S.ev.recipes || []).find((x) => x.id === b.dataset.rcook); if (!r) return;
    S.rmenu = null;
    r.cooked = !r.cooked; draw();                   // optimistiskt: listan grönas direkt
    write("rcook", { id: b.dataset.rcook }, true);
  });
  document.querySelectorAll("[data-rimg]").forEach((b) => b.onclick = async () => {
    const r = (S.ev.recipes || []).find((x) => x.id === b.dataset.rimg); if (!r) return;
    S.rmenu = null; draw();
    const v = prompt(`Bild för ”${r.title}”\n\nKlistra in en bild-länk, eller en sidlänk vars bild hämtas.\nTomt fält tar bort bilden.`, r.image || "");
    if (v === null) return;
    await write("rimage", { id: b.dataset.rimg, image: v.trim() });
  });
  const R_FEL = {
    link_unreadable: "Kunde inte läsa receptet från länken. Kolla att den funkar — eller skriv bara rättens namn.",
    kv_full: "Molnlagret har nått dagens gräns — inget kan sparas förrän det nollställs vid midnatt UTC.",
    empty: "Skriv rättens namn, eller klistra in en recept-länk.",
    inga_utvalda: "Stjärnmärk minst en rätt först — bara utvalda rätter hamnar i inköpslistan.",
    full: "Inköpslistan är full. Ta bort några rader först.",
    rate_limited: "För många ändringar just nu. Vänta en stund.",
  };
  const rAdd = $("rAdd"); if (rAdd) rAdd.onclick = async () => {
    // EN ruta för både namn och länk. Ser texten ut som en länk behandlas den som en länk —
    // ingen ska behöva välja rätt fält innan hen får skriva.
    const v = ($("rNew").value || "").trim();
    const arLank = /^https?:\/\/\S+$/i.test(v);
    const t = arLank ? "" : v, u = arLank ? v : "";
    const msg = $("rMsg");
    if (!t && !u) { msg.textContent = R_FEL.empty; return; }
    rAdd.disabled = true; msg.textContent = u ? "Hämtar receptet…" : "Sparar…";
    // Egen felhantering i stället för write():s alert — en gäst ska få veta VAD som gick fel,
    // och knappen måste bli klickbar igen så förslaget kan räddas med bara ett namn.
    try {
      const d = await api(`/api/fest40?slug=${encodeURIComponent(slug)}&kind=recipe`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pw: S.pw, name: S.me, title: t, url: u }),
      });
      S.ev = d.event; S.log = d.changelog || []; draw();
    } catch (e) {
      rAdd.disabled = false;
      msg.textContent = R_FEL[e.message] || ("Kunde inte spara: " + e.message);
    }
  };

  const sh = $("share"); if (sh) sh.onclick = async () => {
    const url = location.href, title = S.ev.info.title;
    try { if (navigator.share) return await navigator.share({ title, text: `${title} — planeringssidan`, url }); } catch (e) { return; }
    try { await navigator.clipboard.writeText(url); sh.textContent = "Länk kopierad ✓"; setTimeout(() => sh.textContent = "Dela sidan", 2000); } catch (e) {}
  };
  const st = $("sticky"); if (st) window.onscroll = () => { st.style.display = window.scrollY > 220 ? "flex" : "none"; };
}

// autologin om koden redan är sparad, annars grind (öppet event släpper in direkt)
(async () => {
  let saved = ""; try { saved = localStorage.getItem("fest40:pw") || ""; } catch (e) {}
  try { await load(saved); } catch (e) { $("g-title").textContent = "Kalaset"; $("g-date").textContent = "Privat planeringssida"; }
})();
</script>
</body>
</html>
